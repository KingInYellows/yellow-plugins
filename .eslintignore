# ESLint ignore patterns
# Part of Task I1.T1: Bootstrap pnpm workspace

# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
**/dist/
build/
**/build/

# Coverage
coverage/
**/coverage/

# Serena Python project (unrelated)
serena/

# Generated documentation
docs/api/

# Git
.git/

# IDE
.vscode/
.idea/

# Config files
*.config.js
*.config.ts

# Claude Code workflow scripts (plugins/*/workflows/*.js) use top-level
# `return` beside `export const meta`, which no ESLint sourceType parses.
# tests/integration/review-gate-workflow.test.ts executes them instead.
plugins/*/workflows/
