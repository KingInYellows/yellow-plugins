#!/bin/sh
# Logging shim: record every git call, then run the real git.
printf '%s\n' "$*" >>"$STUB_DIR/git.log"
# STUB_LIST_FAILS_AFTER_CHECKOUT=1: once a checkout has run, `worktree list` fails.
if [ -n "${STUB_LIST_FAILS_AFTER_CHECKOUT:-}" ]; then
  case " $* " in
    *" worktree list "*) [ ! -e "$STUB_DIR/list-fails" ] || exit 128 ;;
    *" checkout "*)
      "$STUB_REAL_GIT" "$@"
      rc=$?
      : >"$STUB_DIR/list-fails"
      exit "$rc"
      ;;
  esac
fi
exec "$STUB_REAL_GIT" "$@"
