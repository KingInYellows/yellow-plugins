#!/bin/bash
# Run resolve_pr.verify_command before resolver fixes are committed. On
# failure or timeout, save the resolver diff as a patch, revert the listed
# files and report whether the tree is clean again.
# Usage: run-verify-command --pr <N> --timeout <s> --command-file <f> --trusted
#                           [--files-from <file>] [-- <files...>]
#   --trusted: required. The caller sets it only after confirming the command
#              came from an untracked config file (unattended) or after the
#              user approved it (interactive).
#   files:     repo-root-relative paths the resolvers modified, one per line
#              in --files-from and/or after --. Each must have changes, must
#              not be gitignored, and must not be on the resolver deny list,
#              so a revert can never delete a user file.
# Output: JSON to stdout:
#   {"result":"pass|fail|timeout","patch":"<path>|null","log":"<path>","treeClean":true|false}
# Exit codes: 0 ran (read "result"), 2 usage or not trusted.
# Files: $(git rev-parse --git-common-dir)/yellow-review/resolve-patches/
#        <pr>-<ts>.patch and .log, mode 0600; the newest 10 of each are kept.
# Env: YELLOW_REVIEW_NO_TIMEOUT_BIN=1 forces the watchdog fallback (tests).
# Contract: references/resolve/dispositions.md

set -uo pipefail

KILL_AFTER=10
LOG_CAP_BYTES=1048576
KEEP=10

die() { printf '[run-verify-command] Error: %s\n' "$2" >&2; exit "$1"; }
usage() {
    printf 'Usage: run-verify-command --pr <N> --timeout <s> --command-file <f> --trusted [--files-from <file>] [-- <files...>]\n' >&2
    exit 2
}

PR=""
TIMEOUT=""
COMMAND_FILE=""
TRUSTED=0
FILES=()
while [ $# -gt 0 ]; do
    case "$1" in
        --pr) [ $# -ge 2 ] || usage; PR="$2"; shift 2 ;;
        --timeout) [ $# -ge 2 ] || usage; TIMEOUT="$2"; shift 2 ;;
        --command-file) [ $# -ge 2 ] || usage; COMMAND_FILE="$2"; shift 2 ;;
        --trusted) TRUSTED=1; shift ;;
        --files-from)
            [ $# -ge 2 ] || usage
            [ -f "$2" ] && [ -r "$2" ] || die 2 "--files-from not readable: $2"
            while IFS= read -r line || [ -n "$line" ]; do
                [ -n "$line" ] && FILES+=("$line")
            done <"$2"
            shift 2
            ;;
        --) shift; FILES+=("$@"); break ;;
        *) usage ;;
    esac
done

[ "$TRUSTED" = 1 ] || die 2 "refusing to run an untrusted verify command (pass --trusted only after the tracked-file check or user approval)"
[[ "$PR" =~ ^[1-9][0-9]*$ ]] || die 2 "--pr must be a positive integer"
[[ "$TIMEOUT" =~ ^[1-9][0-9]*$ ]] || die 2 "--timeout must be a positive integer (seconds)"
[ -f "$COMMAND_FILE" ] && [ -r "$COMMAND_FILE" ] || die 2 "--command-file not readable: $COMMAND_FILE"
[ -n "$(tr -d '[:space:]' <"$COMMAND_FILE")" ] || die 2 "--command-file is empty"
COMMAND_FILE=$(cd -- "$(dirname -- "$COMMAND_FILE")" && pwd)/$(basename -- "$COMMAND_FILE")

TOP=$(git rev-parse --show-toplevel 2>/dev/null) || die 2 "not inside a git repository"
cd -- "$TOP" || die 2 "cannot enter $TOP"
# Mirrors pr-comment-resolver's deny list.
is_denied() {
    case "$1" in
        .github/*|.circleci/*|.git/*|.claude/*|yellow-plugins.local.md) return 0 ;;
    esac
    case "${1##*/}" in
        .gitlab-ci.yml|Jenkinsfile|azure-pipelines.yml|Dockerfile|docker-compose.yml) return 0 ;;
        .env|.env.*|secrets.*|*.pem|*.key|*.p12|*.pfx|*.tfvars|*.tfstate) return 0 ;;
    esac
    return 1
}

for f in ${FILES[@]+"${FILES[@]}"}; do
    case "$f" in
        ''|/*|../*|*/../*|*/..|..) die 2 "path must be repo-relative and inside the repository: $f" ;;
    esac
    [[ "$f" =~ [[:cntrl:]] ]] && die 2 "path contains control characters"
    is_denied "$f" && die 2 "refusing a deny-listed path: $f"
    git check-ignore -q -- "$f" && die 2 "refusing a gitignored path: $f"
    [ -n "$(git status --porcelain --untracked-files=all -- "$f")" ] || die 2 "listed file has no changes: $f"
done

# cwd is the top level, so the relative common dir resolves correctly (and
# works on git older than 2.31, which lacks --path-format).
COMMON=$(cd -- "$(git rev-parse --git-common-dir)" && pwd) || die 2 "cannot resolve the git common dir"
OUT_DIR="$COMMON/yellow-review/resolve-patches"
(umask 077 && mkdir -p -- "$OUT_DIR") || die 2 "cannot create $OUT_DIR"
chmod 700 -- "$OUT_DIR" 2>/dev/null || true
STAMP="$PR-$(date -u +%Y%m%dT%H%M%SZ)-$$"
LOG="$OUT_DIR/$STAMP.log"
PATCH="$OUT_DIR/$STAMP.patch"
(umask 077 && : >"$LOG")

timeout_bin() {
    [ "${YELLOW_REVIEW_NO_TIMEOUT_BIN:-0}" = 1 ] && return 1
    local t
    for t in timeout gtimeout; do
        if command -v "$t" >/dev/null 2>&1 && "$t" --kill-after=1 1 true >/dev/null 2>&1; then
            printf '%s' "$t"
            return 0
        fi
    done
    return 1
}

# Watchdog fallback: the command and the watchdog each get their own process
# group (set -m); a marker file separates a real timeout from a command that
# happens to exit 124. Sets TIMED_OUT=1 on a real timeout.
run_with_watchdog() {
    local marker="$OUT_DIR/.$STAMP.timed-out" pid wd rc=0
    rm -f -- "$marker"
    set -m
    bash -c "$(cat -- "$COMMAND_FILE")" >>"$LOG" 2>&1 </dev/null &
    pid=$!
    (
        exec >/dev/null 2>&1 </dev/null
        sleep "$TIMEOUT"
        : >"$marker"
        kill -s TERM -- "-$pid" 2>/dev/null
        sleep "$KILL_AFTER"
        kill -s KILL -- "-$pid" 2>/dev/null
    ) &
    wd=$!
    set +m
    # set -m moved the command out of our foreground group; forward Ctrl-C.
    trap 'kill -s INT -- "-$pid" 2>/dev/null' INT
    wait "$pid" || rc=$?
    trap - INT
    kill -s TERM -- "-$wd" 2>/dev/null
    wait "$wd" 2>/dev/null
    if [ -e "$marker" ]; then
        rm -f -- "$marker"
        TIMED_OUT=1
    fi
    return "$rc"
}

RC=0
TIMED_OUT=0
if T=$(timeout_bin); then
    START=$SECONDS
    "$T" --kill-after="$KILL_AFTER" "$TIMEOUT" bash -c "$(cat -- "$COMMAND_FILE")" >>"$LOG" 2>&1 </dev/null || RC=$?
    # timeout(1) exits 124 on expiry, or 137 when it had to send KILL; the
    # command can exit with either code itself, so also require the time.
    case "$RC" in
        124|137) [ $((SECONDS - START)) -ge "$TIMEOUT" ] && TIMED_OUT=1 ;;
    esac
else
    run_with_watchdog || RC=$?
fi

# Keep the tail of an oversized log: failures usually print last.
if [ "$(wc -c <"$LOG")" -gt "$LOG_CAP_BYTES" ]; then
    (umask 077 && tail -c "$LOG_CAP_BYTES" <"$LOG" >"$LOG.tmp") && mv -f -- "$LOG.tmp" "$LOG"
fi

prune() {
    local ext="$1" f n=0
    # Stamps sort by time within a PR; sort across PRs by mtime.
    while IFS= read -r f; do
        n=$((n + 1))
        [ "$n" -gt "$KEEP" ] && rm -f -- "$f"
    done < <(ls -1t -- "$OUT_DIR"/*."$ext" 2>/dev/null)
}

if [ "$RC" -eq 0 ] && [ "$TIMED_OUT" = 0 ]; then
    prune log
    jq -nc --arg log "$LOG" '{result: "pass", patch: null, log: $log, treeClean: true}'
    exit 0
fi

RESULT=fail
[ "$TIMED_OUT" = 1 ] && RESULT=timeout

# --- Save the resolver diff (tracked and untracked listed files) ---
(
    umask 077
    : >"$PATCH"
    for f in ${FILES[@]+"${FILES[@]}"}; do
        if git ls-files --error-unmatch -- "$f" >/dev/null 2>&1; then
            git diff HEAD -- "$f" >>"$PATCH"
        elif [ -e "$f" ]; then
            git diff --no-index -- /dev/null "$f" >>"$PATCH" || true
        fi
    done
)

# --- Revert the listed files ---
for f in ${FILES[@]+"${FILES[@]}"}; do
    if git ls-files --error-unmatch -- "$f" >/dev/null 2>&1 || git cat-file -e "HEAD:$f" 2>/dev/null; then
        git checkout -q HEAD -- "$f" 2>/dev/null || true
    else
        rm -f -- "$f"
    fi
done

CLEAN=true
[ -z "$(git status --porcelain --untracked-files=no)" ] || CLEAN=false
for f in ${FILES[@]+"${FILES[@]}"}; do
    git ls-files --error-unmatch -- "$f" >/dev/null 2>&1 || { [ -e "$f" ] && CLEAN=false; }
done

prune log
prune patch
jq -nc --arg r "$RESULT" --arg p "$PATCH" --arg log "$LOG" --argjson clean "$CLEAN" \
    '{result: $r, patch: $p, log: $log, treeClean: $clean}'
exit 0
