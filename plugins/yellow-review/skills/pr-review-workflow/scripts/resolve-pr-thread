#!/bin/sh
# Resolve a single PR review thread via GitHub GraphQL API.
# Usage: resolve-pr-thread <thread-node-id>
# Output: JSON to stdout: {"resolved": true, "threadId": "PRRT_..."}
# Exit codes: 1 other failure, 2 usage, 3 not found or permission,
#             4 rate limited. Messages go to stderr.
# Env: YELLOW_REVIEW_PACE_SECONDS (default 1) — sleep after the mutation.
#      YELLOW_REVIEW_RATE_LIMIT_WAIT (default 60) — wait before the single
#      rate-limit retry.
# Contract: references/resolve/dispositions.md

set -eu

# --- Dependency checks ---
command -v gh >/dev/null 2>&1 || { printf 'Error: gh CLI not found. Install from https://cli.github.com\n' >&2; exit 1; }
command -v jq >/dev/null 2>&1 || { printf 'Error: jq not found. Install from https://jqlang.github.io/jq\n' >&2; exit 1; }

# --- Input validation ---
if [ $# -lt 1 ]; then
    printf 'Usage: resolve-pr-thread <thread-node-id>\n' >&2
    exit 2
fi

THREAD_ID="$1"

# Validate thread ID format (must start with PRRT_)
case "$THREAD_ID" in
    PRRT_*)
        # Valid prefix
        ;;
    *)
        printf 'Error: Invalid thread ID format. Expected PRRT_ prefix, got: %s\n' "$THREAD_ID" >&2
        exit 2
        ;;
esac

# --- GraphQL mutation ---
# shellcheck disable=SC2016
MUTATION='
mutation($threadId: ID!) {
  resolveReviewThread(input: { threadId: $threadId }) {
    thread {
      id
      isResolved
    }
  }
}'

# --- Execute mutation (one retry after a rate limit) ---
_STDERR_FILE=$(mktemp)
trap 'rm -f "$_STDERR_FILE"' EXIT
call() {
    RESPONSE=$(gh api graphql \
        -F threadId="$THREAD_ID" \
        -f query="$MUTATION" 2>"$_STDERR_FILE") && _GH_EXIT=0 || _GH_EXIT=$?
    _GH_STDERR=$(cat "$_STDERR_FILE")
    sleep "${YELLOW_REVIEW_PACE_SECONDS:-1}"
}
is_rate_limited() {
    case "$_GH_STDERR" in *"rate limit"*|*"Rate limit"*|*"HTTP 429"*) return 0 ;; esac
    # GraphQL-level rate limits arrive as HTTP 200 with an .errors payload.
    printf '%s' "$RESPONSE" | jq -e '[.errors[]? | (.type // ""), (.message // "")] | any(test("rate limit|RATE_LIMITED"; "i"))' >/dev/null 2>&1
}
is_gql_not_found_or_forbidden() {
    printf '%s' "$RESPONSE" | jq -e '[.errors[]? | .type // empty] | any(. == "NOT_FOUND" or . == "FORBIDDEN")' >/dev/null 2>&1
}
call
if is_rate_limited; then
    # Capped so the call fits the caller's Bash timeout.
    _WAIT="${YELLOW_REVIEW_RATE_LIMIT_WAIT:-60}"
    case "$_WAIT" in ''|*[!0-9]*) _WAIT=60 ;; esac
    [ "$_WAIT" -le 90 ] || _WAIT=90
    printf '[resolve-pr-thread] Rate limited; retrying once in %ss.\n' "$_WAIT" >&2
    sleep "$_WAIT"
    call
fi
if is_rate_limited; then
    printf 'Error: GitHub API rate limit exceeded. Wait and retry.\n' >&2
    exit 4
fi
if [ "$_GH_EXIT" -ne 0 ]; then
    case "$_GH_STDERR" in
        *"HTTP 401"*|*"Bad credentials"*|*"authentication"*)
            printf 'Error: Authentication failed. Run "gh auth login" to re-authenticate.\n' >&2
            ;;
        *"Could not resolve"*|*"not found"*|*"NOT_FOUND"*)
            printf 'Error: Thread not found: %s\n' "$THREAD_ID" >&2
            exit 3
            ;;
        *"HTTP 403"*|*"FORBIDDEN"*|*"not accessible"*|*"permission"*)
            printf 'Error: Not permitted to resolve thread: %s\n' "$THREAD_ID" >&2
            exit 3
            ;;
        *"already resolved"*|*"ALREADY_RESOLVED"*)
            # Idempotent — treat as success
            jq -n --arg id "$THREAD_ID" '{"resolved": true, "threadId": $id}'
            exit 0
            ;;
        *)
            printf 'Error: GraphQL mutation failed: %s\n' "$_GH_STDERR" >&2
            ;;
    esac
    exit 1
fi

# --- Validate response ---
IS_RESOLVED=$(printf '%s' "$RESPONSE" | jq -r '.data.resolveReviewThread.thread.isResolved // empty') || {
    printf '[resolve-pr-thread] Error: Failed to parse mutation response.\n' >&2
    exit 1
}

if [ "$IS_RESOLVED" = "true" ]; then
    jq -n --arg id "$THREAD_ID" '{"resolved": true, "threadId": $id}'
else
    # Check for GraphQL-level errors
    ERRORS=$(printf '%s' "$RESPONSE" | jq -r '.errors[0].message // empty') || {
        printf '[resolve-pr-thread] Error: Failed to parse GraphQL error response.\n' >&2
        exit 1
    }
    if is_gql_not_found_or_forbidden; then
        printf 'Error: Thread not found or not permitted: %s\n' "$THREAD_ID" >&2
        exit 3
    fi
    if [ -n "$ERRORS" ]; then
        # Check for already-resolved in error message (idempotent)
        case "$ERRORS" in
            *"already resolved"*)
                jq -n --arg id "$THREAD_ID" '{"resolved": true, "threadId": $id}'
                exit 0
                ;;
        esac
        printf 'Error: %s\n' "$ERRORS" >&2
    else
        printf 'Error: Thread resolution returned unexpected state.\n' >&2
    fi
    exit 1
fi
