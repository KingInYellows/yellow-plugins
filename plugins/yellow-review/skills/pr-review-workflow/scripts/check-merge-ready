#!/bin/sh
# Read-only merge-readiness gate for one PR. Makes no GitHub writes and adds
# no ledger records. It reads the ledger only when the current checkout's
# origin is <owner/repo> and the PR already has ledger files; that read takes
# the ledger lock like any other ledger read.
# Usage: check-merge-ready <owner/repo> <pr-number>
# Output: one JSON object on stdout:
#   {"pr":N,"head":"<sha>"|null,"state":"OPEN|CLOSED|MERGED"|null,
#    "verdict":"ready|blocked|unknown",
#    "blockers":[...],"unknowns":[...],
#    "isDraft":bool|null,"mergeable":"MERGEABLE|CONFLICTING|UNKNOWN"|null,
#    "mergeStateStatus":"..."|null,"queued":bool|null,
#    "threads":{"unresolved":N,"outdated":N}|null,
#    "changesRequested":["login",...]|null,"reviewDecision":"..."|null,
#    "conversationResolution":"enforced|not_enforced|unknown",
#    "ci":{"state":"SUCCESS|PENDING|EXPECTED|FAILURE|ERROR|NONE"|null,
#          "failing":[names],"pending":[names],"truncated":bool},
#    "ledger":{"status":"read|partial|none|other_repo|unavailable",
#              "mergeBlocking":N|null,"skipped":N|null},
#    "approval":{"mode":"off|advisory|enforce",
#                "tier":"low|medium|high|unknown"|null,
#                "policy":"default_branch|none|invalid"|null,
#                "required":0|1|null,
#                "humanApproval":{"login":"...","commit":"<sha>"}|null,
#                "extras":{"crossLineage":bool|null,"freshReview":null},
#                "missing":[tokens]}}
# blockers holds fixed tokens: not_open, draft, conflicts, unresolved_threads,
# changes_requested, review_required, ci_failing, ci_pending, ledger_findings,
# and in enforce mode approval_required, approval_stale, cross_lineage_missing.
# unknowns names what could not be read: pr_state, threads, reviews, ci,
# mergeable (GitHub reports UNKNOWN while it is still computing the merge),
# ledger (the PR has ledger files but the summary failed, or status partial:
# the summary skipped unreadable records, any of which may be a pending
# finding; mergeBlocking still counts the records that were read),
# merge_state (mergeStateStatus is BLOCKED or BEHIND: GitHub refuses the merge
# for a reason this gate may not see, such as a required check that never
# reported on the head or a base branch that must be merged in first, so the
# PR is not reported ready).
# approval (enforce mode only: the tier or the approval evidence could not be
# read).
# A blocker is definite; an unknown is never read as "no blocker".
# Unresolved threads count outdated ones too, whether or not the base branch
# enforces conversation resolution (conversationResolution is reported only).
# CI is green when the head commit's status-check rollup is SUCCESS (GitHub
# counts skipped and neutral runs as passing) or the head has no checks at all
# (NONE). The failing/pending name lists cover the first 100 contexts;
# truncated is true past that, and the verdict still comes from the rollup.
# A missing ledger (status none: no checkout, or no files for the PR) does not
# block: the queue rule needs CI, threads and reviews, and cloud sessions never
# hold a local ledger. A checkout of another repository (other_repo) is not
# read, since ledger files are keyed by PR number only.
# Approval by risk (CLAUDE-234): the tier comes from classify-risk over the
# PR's file list (files API, renamed files' old paths included) with
# .github/review-risk.json fetched through the contents API at the tip of the
# repository's default branch, never the PR head or its base branch (in a
# stack the base is the parent PR's unmerged branch, which could weaken the
# policy for the child). No policy there is default medium (policy none).
# low needs no human; medium needs a listed human's approval of the head SHA
# (a User account, never a Bot): an APPROVED review on it, or adding the
# graphite-queue label at or after the time the head arrived, which is the
# later of its committer date and its first check suite (GitHub blocks
# self-approval, so the owner approves by queueing; humanApproval.via is
# review or label). An approval or label from before the head only is
# approval_stale; a label with no readable head time is head_time_unknown.
# high needs the same plus a review on the head SHA
# by a listed cross-lineage bot. freshReview is always null: the review
# ledger records a head SHA per finding, not per run, and a clean run writes
# no record, so nothing proves a fresh review of the head (missing token
# fresh_review_unknown). Other missing tokens: approval_required,
# approval_stale, cross_lineage_missing, head_time_unknown, tier_unknown (the file list, the
# policy or the classification failed, or the head moved during the run;
# required is then null and no other token is listed), reviews_unknown.
# Config: yellow-plugins.local.md at the root of a checkout of <owner/repo>,
# only when git does not track it (a tracked file could be edited by a PR, so
# its keys are ignored with a note): review_approval_gate off|advisory|enforce
# (default advisory), review_approval_humans (default: the repository owner's
# login) and review_cross_lineage_bots (default chatgpt-codex-connector[bot]),
# each list a flow ([a, b]) or block (- a) sequence of logins. advisory lists
# approval.missing only and leaves the verdict alone; enforce turns
# approval_required, approval_stale and cross_lineage_missing into blockers
# and any other token into the approval unknown; off makes no approval calls
# and reports mode off with every other approval field null.
# Exit: 0 ready, 1 blocked (any blocker, even with unknowns), 3 unknown (no
# blocker but something unread), 2 usage. Every lookup failure exits 1 or 3
# with a note on stderr, never with an empty stdout; with jq missing or no
# temp directory the report keeps its shape with every field null.
# Time bound: get-pr-comments (270 s deadline) and get-pr-blockers (up to
# 360 s) run in the background while the foreground makes the state query
# and, unless approval is off, three approval calls (reviews, the paginated
# file list, the policy), each under one rg_gh timeout (30 s by default, 60 s
# at most): 240 s at most. The worst case stays about 370 s, inside the
# 420000 ms Bash tool timeout merge-ready.md gives the call.

set -eu

note() { printf '[check-merge-ready] %s\n' "$1" >&2; }

if [ $# -ne 2 ]; then
    printf 'Usage: check-merge-ready <owner/repo> <pr-number>\n' >&2
    exit 2
fi

REPO="$1"
PR_NUMBER="$2"

case "$REPO" in
    */*/*|/*|*/) printf 'Error: Invalid repo format. Expected owner/repo, got: %s\n' "$REPO" >&2; exit 2 ;;
    */*) OWNER="${REPO%%/*}"; NAME="${REPO#*/}" ;;
    *) printf 'Error: Invalid repo format. Expected owner/repo, got: %s\n' "$REPO" >&2; exit 2 ;;
esac
case "$OWNER$NAME" in
    *[!A-Za-z0-9._-]*) printf 'Error: Invalid repo format. Expected owner/repo, got: %s\n' "$REPO" >&2; exit 2 ;;
esac
case "$PR_NUMBER" in
    ''|0*|*[!0-9]*) printf 'Error: PR number must be a positive integer, got: %s\n' "$PR_NUMBER" >&2; exit 2 ;;
esac
[ "${#PR_NUMBER}" -le 9 ] || { printf 'Error: PR number too long: %s\n' "$PR_NUMBER" >&2; exit 2; }

# all_unknown: the full report shape with nothing read; built without jq.
all_unknown() {
    printf '{"pr":%s,"head":null,"state":null,"verdict":"unknown","blockers":[],"unknowns":["pr_state","threads","reviews","ci"],"isDraft":null,"mergeable":null,"mergeStateStatus":null,"queued":null,"threads":null,"changesRequested":null,"reviewDecision":null,"conversationResolution":"unknown","ci":{"state":null,"failing":[],"pending":[],"truncated":false},"ledger":{"status":"unavailable","mergeBlocking":null,"skipped":null},"approval":null}\n' "$PR_NUMBER"
}

if ! command -v jq >/dev/null 2>&1; then
    note 'jq not found; readiness unknown'
    all_unknown
    exit 3
fi

HERE=$(dirname -- "$0")
RESOLVE_GH_LIB="$HERE/../../../lib/resolve-gh.sh"
LEDGER_LIB="$HERE/../../../lib/review-ledger.sh"

WORK=$(mktemp -d "${TMPDIR:-/tmp}/check-merge-ready.XXXXXX") || { note 'mktemp failed; readiness unknown'; all_unknown; exit 3; }
trap 'rm -rf "$WORK"' EXIT

# --- Is the current directory a checkout of <owner/repo>? ---
# The ledger and the approval config are read only from such a checkout.
SAME_REPO=false
TOP=""
COMMON_DIR=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || COMMON_DIR=""
if [ -n "$COMMON_DIR" ]; then
    ORIGIN=$(git config --get remote.origin.url 2>/dev/null) || ORIGIN=""
    ORIGIN=${ORIGIN%/}
    ORIGIN=${ORIGIN%.git}
    ORIGIN_REPO=$(printf '%s' "$ORIGIN" | awk -F'[/:]' 'NF >= 2 { print $(NF-1) "/" $NF }' | tr '[:upper:]' '[:lower:]')
    WANT_REPO=$(printf '%s/%s' "$OWNER" "$NAME" | tr '[:upper:]' '[:lower:]')
    [ "$ORIGIN_REPO" != "$WANT_REPO" ] || SAME_REPO=true
    TOP=$(git rev-parse --show-toplevel 2>/dev/null) || TOP=""
fi

# --- Approval config (yellow-plugins.local.md, untracked only) ---
CFG_NAME=yellow-plugins.local.md
CFG_FILE=absent
: >"$WORK/config"
if [ "$SAME_REPO" = true ] && [ -n "$TOP" ] && { [ -e "$TOP/$CFG_NAME" ] || [ -L "$TOP/$CFG_NAME" ]; }; then
    CFG_RC=0
    git -C "$TOP" ls-files --error-unmatch -- "$CFG_NAME" >/dev/null 2>&1 || CFG_RC=$?
    if [ "$CFG_RC" -ne 1 ]; then
        note "$CFG_NAME is tracked by git (or git could not tell); approval keys ignored"
    elif [ -L "$TOP/$CFG_NAME" ] || [ ! -f "$TOP/$CFG_NAME" ]; then
        note "$CFG_NAME is a symlink or not a regular file; approval keys ignored"
    elif head -c 65537 -- "$TOP/$CFG_NAME" >"$WORK/config" 2>/dev/null \
        && [ "$(wc -c <"$WORK/config")" -le 65536 ]; then
        CFG_FILE=present
    else
        note "$CFG_NAME is unreadable or over 64 KiB; approval keys ignored"
        : >"$WORK/config"
    fi
fi
# Top-level keys of the frontmatter only. A key given twice, a value that is
# not a list or a login outside GitHub's characters warns and is dropped.
jq -n -c --rawfile text "$WORK/config" --arg file "$CFG_FILE" '
  def strip: sub("[ \\t]+#.*\\z"; "") | sub("\\A[ \\t]+"; "") | sub("[ \\t]+\\z"; "");
  def unq: if test("\\A\".*\"\\z") or test("\\A\u0027.*\u0027\\z") then .[1:-1] else . end;
  ($text | split("\n") | map(sub("\r\\z"; ""))) as $lines
  | (if $file != "present" or ($lines[0] // "") != "---" then []
     else ([range(1; $lines | length) | select($lines[.] == "---")] | first) as $end
       | if $end == null then [] else $lines[1:$end] end end) as $fm
  | def value($k):
      [range(0; $fm | length) | select($fm[.] | startswith($k + ":"))] as $e
      | if ($e | length) == 0 then {state: "unset"}
        elif ($e | length) > 1 then {state: "twice"}
        else ($fm[$e[0]] | .[($k | length) + 1:] | strip) as $v
          | if $v != "" then {state: "set", v: $v}
            else ($fm[$e[0] + 1:] | (map(test("\\A[ \\t]+-") | not) | index(true)) as $stop
                  | if $stop == null then . else .[0:$stop] end) as $items
              | {state: "set", list: [$items[] | sub("\\A[ \\t]+-[ \\t]*"; "") | strip | unq]}
            end
        end;
    def logins($k; $re):
      value($k) as $x
      | if $x.state == "unset" then {v: null, w: []}
        elif $x.state == "twice" then {v: null, w: ["\($k) is given more than once; using the default"]}
        else (if $x.list != null then $x.list
              elif ($x.v | test("\\A\\[.*\\]\\z")) then ($x.v[1:-1] | split(",") | map(strip | unq) | map(select(. != "")))
              else null end) as $l
          | if $l == null then {v: null, w: ["\($k) is not a list; using the default"]}
            else ($l | map(select(test($re)))) as $ok
              | {v: (if ($ok | length) == 0 then null else $ok end),
                 w: ((if ($l | map(select(test($re) | not)) | length) > 0 then ["\($k) has an invalid login; ignored"] else [] end)
                     + (if ($ok | length) == 0 then ["\($k) lists no valid login; using the default"] else [] end))}
            end
        end;
    value("review_approval_gate") as $g
  | (if $g.state == "set" and ($g.v // "" | strip | unq | IN("off", "advisory", "enforce"))
     then {v: ($g.v | strip | unq), w: []}
     elif $g.state == "unset" then {v: "advisory", w: []}
     else {v: "advisory", w: ["review_approval_gate is invalid; using advisory"]} end) as $mode
  | logins("review_approval_humans"; "\\A[A-Za-z0-9][A-Za-z0-9-]{0,38}\\z") as $h
  | logins("review_cross_lineage_bots"; "\\A[A-Za-z0-9][A-Za-z0-9-]{0,38}(?:\\[bot\\])?\\z") as $b
  | {mode: $mode.v, humans: $h.v, bots: $b.v, warnings: ($mode.w + $h.w + $b.w)}
' >"$WORK/acfg" 2>/dev/null || {
    note "could not parse $CFG_NAME; approval keys take their defaults"
    printf '{"mode":"advisory","humans":null,"bots":null,"warnings":[]}' >"$WORK/acfg"
}
jq -r '.warnings[]' "$WORK/acfg" | while IFS= read -r w; do note "Warning: $w"; done
APPROVAL_MODE=$(jq -r '.mode' "$WORK/acfg")
# The label whose addition by a listed human counts as approval: GitHub will
# not let a repository owner approve their own PR, so the owner approves by
# queueing it. Claude adds this label only to low-tier PRs.
APPROVAL_LABEL=graphite-queue

# --- Threads and reviews run in the background (each can take minutes) ---
THREADS_RC=0
"$HERE/get-pr-comments" --include-outdated "$OWNER/$NAME" "$PR_NUMBER" \
    >"$WORK/threads" 2>"$WORK/threads.err" &
THREADS_PID=$!
BLOCKERS_RC=0
"$HERE/get-pr-blockers" "$OWNER/$NAME" "$PR_NUMBER" \
    >"$WORK/blockers" 2>"$WORK/blockers.err" &
BLOCKERS_PID=$!

# --- PR state, labels and the head commit's checks (GraphQL) ---
# shellcheck disable=SC2016
QUERY='
query MergeReadyState($owner: String!, $name: String!, $number: Int!) {
  repository(owner: $owner, name: $name) {
    pullRequest(number: $number) {
      state
      isDraft
      mergeable
      mergeStateStatus
      headRefOid
      labels(first: 100) { nodes { name } }
      commits(last: 1) {
        nodes {
          commit {
            oid
            statusCheckRollup {
              state
              contexts(first: 100) {
                pageInfo { hasNextPage }
                nodes {
                  __typename
                  ... on CheckRun { name status conclusion }
                  ... on StatusContext { context state }
                }
              }
            }
          }
        }
      }
    }
  }
}'

STATE_OK=false
GH_READY=false
if ! command -v gh >/dev/null 2>&1; then
    note 'gh not found; PR state and CI unknown'
elif [ ! -r "$RESOLVE_GH_LIB" ]; then
    note "cannot read $RESOLVE_GH_LIB; PR state and CI unknown"
else
    # shellcheck source=../../../lib/resolve-gh.sh
    . "$RESOLVE_GH_LIB"
    GH_READY=true
    STATE_RC=0
    rg_gh api graphql -f owner="$OWNER" -f name="$NAME" -F "number=$PR_NUMBER" \
        -f query="$QUERY" >"$WORK/state" 2>"$WORK/state.err" || STATE_RC=$?
    if [ "$STATE_RC" -eq 0 ] && jq -e '((.errors // []) | length) == 0 and (.data.repository.pullRequest | type) == "object"' \
        "$WORK/state" >/dev/null 2>&1; then
        STATE_OK=true
    else
        [ "$STATE_RC" -ne 124 ] || note "gh timed out after ${RG_GH_TIMEOUT}s on the state lookup"
        note "state lookup failed; PR state and CI unknown: $(head -c 300 "$WORK/state.err" | tr '\n' ' ')"
    fi
fi
[ "$STATE_OK" = true ] || printf '{}' >"$WORK/state"

# --- Approval evidence: reviews, tier (skipped entirely when off) ---
# shellcheck disable=SC2016
APPROVAL_QUERY='
query MergeReadyApproval($owner: String!, $name: String!, $number: Int!) {
  repository(owner: $owner, name: $name) {
    defaultBranchRef { target { oid } }
    pullRequest(number: $number) {
      headRefOid
      changedFiles
      reviews(last: 100) {
        nodes { state author { __typename login } commit { oid } }
      }
      commits(last: 1) {
        nodes { commit { oid committedDate checkSuites(first: 100) { nodes { createdAt } } } }
      }
      timelineItems(last: 100, itemTypes: [LABELED_EVENT]) {
        nodes { ... on LabeledEvent { createdAt label { name } actor { __typename login } } }
      }
    }
  }
}'
TIER=unknown
POLICY=null
A_HEAD=""
printf 'null' >"$WORK/reviews"
printf '{"headTime":null,"events":null}' >"$WORK/labels"
if [ "$APPROVAL_MODE" != off ] && [ "$GH_READY" = true ]; then
    A_RC=0
    rg_gh api graphql -f owner="$OWNER" -f name="$NAME" -F "number=$PR_NUMBER" \
        -f query="$APPROVAL_QUERY" >"$WORK/approval.raw" 2>"$WORK/approval.err" || A_RC=$?
    # One space-separated line, every value checked before it reaches a URL.
    A_ROW=""
    if [ "$A_RC" -eq 0 ]; then
        A_ROW=$(jq -r '
          (.data.repository // {}) as $r | ($r.pullRequest // {}) as $p
          | if ((.errors // []) | length) == 0
               and ($p.headRefOid | type == "string" and test("\\A[0-9a-f]{40}\\z"))
               and ($r.defaultBranchRef.target.oid | type == "string" and test("\\A[0-9a-f]{40}\\z"))
               and ($p.changedFiles | type == "number")
               and ($p.reviews.nodes | type == "array")
            then "\($p.headRefOid) \($r.defaultBranchRef.target.oid) \($p.changedFiles)"
            else error("bad approval lookup") end' "$WORK/approval.raw" 2>/dev/null) || A_ROW=""
    fi
    STATE_HEAD=$(jq -r '.data.repository.pullRequest.headRefOid // empty' "$WORK/state" 2>/dev/null) || STATE_HEAD=""
    if [ -z "$A_ROW" ]; then
        [ "$A_RC" -ne 124 ] || note "gh timed out after ${RG_GH_TIMEOUT}s on the approval lookup"
        note "approval lookup failed; tier and reviews unknown: $(head -c 300 "$WORK/approval.err" | tr '\n' ' ')"
    else
        A_HEAD=${A_ROW%% *}
        A_REST=${A_ROW#* }
        POLICY_OID=${A_REST%% *}
        CHANGED=${A_REST#* }
        if [ -n "$STATE_HEAD" ] && [ "$STATE_HEAD" != "$A_HEAD" ]; then
            note "the head moved during the check; tier and reviews unknown"
            A_HEAD=""
        else
            jq '.data.repository.pullRequest.reviews.nodes' "$WORK/approval.raw" >"$WORK/reviews"
            # Label approval: who added the label and when, against the time
            # the head arrived. That time is the later of the head commit's
            # committer date and its first check suite (set by GitHub at
            # push), so an old committer date cannot predate a fresh push.
            jq -c --arg h "$A_HEAD" '
              .data.repository.pullRequest as $p
              | ([($p.commits.nodes // [])[] | .commit | select(.oid == $h)] | first) as $c
              | {headTime: (if $c == null or ($c.committedDate | type) != "string" then null
                            else ([$c.committedDate]
                                  + ([($c.checkSuites.nodes // [])[] | .createdAt | strings] | sort | .[:1]))
                                 | max end),
                 events: (if ($p.timelineItems.nodes | type) == "array"
                          then [$p.timelineItems.nodes[] | select(type == "object" and (.createdAt | type) == "string")]
                          else null end)}' "$WORK/approval.raw" >"$WORK/labels" 2>/dev/null \
              || printf '{"headTime":null,"events":null}' >"$WORK/labels"
        fi
    fi
    if [ -n "$A_HEAD" ]; then
        TIER_OK=false
        F_RC=0
        rg_gh api --paginate "repos/$OWNER/$NAME/pulls/$PR_NUMBER/files?per_page=100" \
            >"$WORK/files" 2>"$WORK/files.err" || F_RC=$?
        # Old and new paths; a name outside the allowlist becomes a path that
        # classify-risk rates high, so it can never lower the tier or forge a
        # row. A list shorter than changedFiles (GitHub stops at 3000) fails.
        if [ "$F_RC" -eq 0 ] && jq -s -r --argjson n "$CHANGED" '
              (map(if type == "array" then . else error("not a list") end) | add // []) as $f
              | if ($f | length) < $n then error("short list") else $f[] end
              | (.filename, (.previous_filename // empty))
              | if type == "string" and test("\\A[A-Za-z0-9._/@+-]+\\z") then . else "unsafe?path" end
            ' "$WORK/files" >"$WORK/paths" 2>/dev/null; then
            P_RC=0
            rg_gh api -H 'Accept: application/vnd.github.raw+json' \
                "repos/$OWNER/$NAME/contents/.github/review-risk.json?ref=$POLICY_OID" \
                >"$WORK/policy.json" 2>"$WORK/policy.err" || P_RC=$?
            if [ "$P_RC" -eq 0 ]; then
                POLICY=default_branch
            elif [ "$P_RC" -ne 124 ] && grep -q 'HTTP 404' "$WORK/policy.err"; then
                POLICY=none
                printf '{"version":1,"default_tier":"medium","rules":[]}\n' >"$WORK/policy.json"
            else
                note "policy lookup failed; tier unknown: $(head -c 300 "$WORK/policy.err" | tr '\n' ' ')"
            fi
            if [ "$POLICY" != null ] && "$HERE/classify-risk" --policy-file "$WORK/policy.json" --stdin \
                <"$WORK/paths" >"$WORK/risk" 2>"$WORK/risk.err" \
                && TIER=$(jq -er '.tier | select(IN("low", "medium", "high"))' "$WORK/risk" 2>/dev/null); then
                TIER_OK=true
                [ "$(jq -r '.policy' "$WORK/risk")" != invalid ] || POLICY=invalid
            elif [ "$POLICY" != null ]; then
                note "classify-risk failed; tier unknown: $(head -c 300 "$WORK/risk.err" | tr '\n' ' ')"
            fi
        else
            note "file list lookup failed or was cut short; tier unknown: $(head -c 300 "$WORK/files.err" | tr '\n' ' ')"
        fi
        [ "$TIER_OK" = true ] || { TIER=unknown; POLICY=null; }
    fi
elif [ "$APPROVAL_MODE" != off ]; then
    note "gh unavailable; tier and reviews unknown"
fi

jq -n -c \
    --arg mode "$APPROVAL_MODE" --arg tier "$TIER" --arg policy "$POLICY" --arg head "$A_HEAD" \
    --arg owner "$OWNER" --slurpfile cfg "$WORK/acfg" --slurpfile rev "$WORK/reviews" \
    --arg label "$APPROVAL_LABEL" --slurpfile lab "$WORK/labels" '
  def norm: ascii_downcase | sub("\\[bot\\]\\z"; "");
  if $mode == "off" then
    {mode: "off", tier: null, policy: null, required: null, humanApproval: null,
     extras: {crossLineage: null, freshReview: null}, missing: []}
  else
    ($cfg[0].humans // [$owner] | map(ascii_downcase)) as $humans
    | ($cfg[0].bots // ["chatgpt-codex-connector[bot]"] | map(norm)) as $bots
    | $rev[0] as $r
    | [($r // [])[] | select(.state == "APPROVED" and .author.__typename == "User"
          and ((.author.login // "") | test("\\[bot\\]\\z") | not)
          and ((.author.login // "") | ascii_downcase | IN($humans[])))] as $appr
    | ([$appr[] | select(.commit.oid == $head)] | last) as $onhead
    | $lab[0].headTime as $ht
    | [($lab[0].events // [])[] | select(.label.name == $label and .actor.__typename == "User"
          and ((.actor.login // "") | test("\\[bot\\]\\z") | not)
          and ((.actor.login // "") | ascii_downcase | IN($humans[])))] as $lbl
    | (if $ht == null then null else ([$lbl[] | select(.createdAt >= $ht)] | last) end) as $lblhead
    | (if $r == null then null
       else any($r[]; ((.author.login // "") | norm | IN($bots[])) and .commit.oid == $head) end) as $xl
    | {mode: $mode, tier: $tier, policy: (if $policy == "null" then null else $policy end),
       required: ({low: 0, medium: 1, high: 1}[$tier]),
       humanApproval: (if $onhead != null then {login: $onhead.author.login, commit: $onhead.commit.oid, via: "review"}
                       elif $lblhead != null then {login: $lblhead.actor.login, commit: $head, via: "label", at: $lblhead.createdAt}
                       else null end),
       extras: {crossLineage: (if $tier == "high" then $xl else null end), freshReview: null},
       missing: (
         if $tier == "unknown" then ["tier_unknown"]
         elif $tier == "low" then []
         else (if $onhead != null or $lblhead != null then []
               elif $r == null then ["reviews_unknown"]
               elif ($lbl | length) > 0 and $ht == null then ["head_time_unknown"]
               elif ($appr | length) > 0 or ($lbl | length) > 0 then ["approval_stale"]
               else ["approval_required"] end)
              + (if $tier == "high" then
                   (if $xl == false then ["cross_lineage_missing"] else [] end) + ["fresh_review_unknown"]
                 else [] end)
         end)}
  end' >"$WORK/approval" 2>/dev/null || {
    note 'could not assemble the approval section; approval unknown'
    jq -n -c --arg mode "$APPROVAL_MODE" '{mode: $mode, tier: (if $mode == "off" then null else "unknown" end),
      policy: null, required: null, humanApproval: null, extras: {crossLineage: null, freshReview: null},
      missing: (if $mode == "off" then [] else ["tier_unknown"] end)}' >"$WORK/approval"
}

wait "$THREADS_PID" || THREADS_RC=$?
wait "$BLOCKERS_PID" || BLOCKERS_RC=$?

# --- Threads: any non-zero exit (3 = truncated list) leaves them unknown ---
THREADS_OK=false
if [ "$THREADS_RC" -eq 0 ] && jq -e 'type == "array"' "$WORK/threads" >/dev/null 2>&1; then
    THREADS_OK=true
else
    note "thread lookup failed (exit $THREADS_RC); threads unknown: $(head -c 300 "$WORK/threads.err" | tr '\n' ' ')"
    printf '[]' >"$WORK/threads"
fi

# --- Reviews: lookupFailed true is unknown, never "no blockers" ---
if [ "$BLOCKERS_RC" -ne 0 ] || ! jq -e 'type == "object" and (.lookupFailed | type) == "boolean"' "$WORK/blockers" >/dev/null 2>&1; then
    note "review lookup failed (exit $BLOCKERS_RC): $(head -c 300 "$WORK/blockers.err" | tr '\n' ' ')"
    printf '{"changesRequested":null,"reviewDecision":null,"conversationResolution":"unknown","lookupFailed":true}' >"$WORK/blockers"
elif jq -e '.lookupFailed' "$WORK/blockers" >/dev/null 2>&1; then
    note "review lookup failed ($(jq -r '.lookupReason // "other"' "$WORK/blockers")); reviews unknown"
fi

# --- Ledger (local, optional) ---
# Ledger files are keyed by PR number alone, so read them only from a checkout
# of the same repository, and call the library only when the PR has files:
# the summary would otherwise create the ledger directory.
LEDGER_STATUS=none
LEDGER_BLOCKING=null
LEDGER_SKIPPED=null
if [ -n "$COMMON_DIR" ]; then
    LEDGER_DIR="$COMMON_DIR/yellow-review/findings"
    if [ "$SAME_REPO" != true ]; then
        LEDGER_STATUS=other_repo
    elif [ -f "$LEDGER_DIR/$PR_NUMBER.jsonl" ] || [ -f "$LEDGER_DIR/$PR_NUMBER.pending" ]; then
        LEDGER_STATUS=unavailable
        if [ -x "$LEDGER_LIB" ] \
            && "$LEDGER_LIB" summary "$PR_NUMBER" >"$WORK/ledger" 2>"$WORK/ledger.err" \
            && LEDGER_BLOCKING=$(jq -e --arg pr "$PR_NUMBER" '.[$pr].merge_blocking | numbers' "$WORK/ledger" 2>/dev/null); then
            LEDGER_STATUS=read
            LEDGER_SKIPPED=$(jq -e --arg pr "$PR_NUMBER" '.[$pr].skipped // 0 | numbers' "$WORK/ledger" 2>/dev/null) || LEDGER_SKIPPED=0
            if [ "$LEDGER_SKIPPED" -gt 0 ]; then
                LEDGER_STATUS=partial
                note "ledger has $LEDGER_SKIPPED unreadable records; ledger unknown"
            fi
        else
            LEDGER_BLOCKING=null
            note "ledger summary unavailable; ledger unknown: $(head -c 200 "$WORK/ledger.err" 2>/dev/null | tr '\n' ' ')"
        fi
    fi
fi

jq -n \
    --argjson pr "$PR_NUMBER" \
    --argjson stateok "$STATE_OK" \
    --argjson threadsok "$THREADS_OK" \
    --slurpfile s "$WORK/state" \
    --slurpfile t "$WORK/threads" \
    --slurpfile b "$WORK/blockers" \
    --slurpfile a "$WORK/approval" \
    --arg lstatus "$LEDGER_STATUS" \
    --argjson lblocking "$LEDGER_BLOCKING" \
    --argjson lskipped "$LEDGER_SKIPPED" '
  ($s[0].data.repository.pullRequest // {}) as $p
  | ($p.commits.nodes[0].commit // {}) as $c
  | ($c.statusCheckRollup) as $roll
  | ($roll.contexts.nodes // []) as $ctx
  | (if $stateok then (if $roll == null then "NONE" else $roll.state end) else null end) as $ci
  | $b[0] as $bl
  | {
      pr: $pr,
      head: (if $stateok then ($p.headRefOid // null) else null end),
      state: (if $stateok then $p.state else null end),
      isDraft: (if $stateok then $p.isDraft else null end),
      mergeable: (if $stateok then $p.mergeable else null end),
      mergeStateStatus: (if $stateok then $p.mergeStateStatus else null end),
      queued: (if $stateok then ([$p.labels.nodes[]?.name] | index("graphite-queue") != null) else null end),
      threads: (if $threadsok then {unresolved: ($t[0] | length), outdated: ([$t[0][] | select(.isOutdated == true)] | length)} else null end),
      changesRequested: (if $bl.lookupFailed then null else [$bl.changesRequested[]?.login] end),
      reviewDecision: (if $bl.lookupFailed then null else $bl.reviewDecision end),
      conversationResolution: ($bl.conversationResolution // "unknown"),
      ci: {
        state: $ci,
        failing: [$ctx[] | select(
            (.__typename == "CheckRun" and .status == "COMPLETED"
              and ((.conclusion // "") | IN("FAILURE","TIMED_OUT","CANCELLED","ACTION_REQUIRED","STARTUP_FAILURE","STALE")))
            or (.__typename == "StatusContext" and ((.state // "") | IN("FAILURE","ERROR"))))
          | (.name // .context)],
        pending: [$ctx[] | select(
            (.__typename == "CheckRun" and .status != "COMPLETED")
            or (.__typename == "StatusContext" and ((.state // "") | IN("PENDING","EXPECTED"))))
          | (.name // .context)],
        truncated: ($roll.contexts.pageInfo.hasNextPage // false)
      },
      ledger: {status: $lstatus, mergeBlocking: $lblocking, skipped: $lskipped},
      approval: $a[0]
    }
  | (.approval.mode == "enforce") as $enforce
  | .blockers = [
      (if .state != null and .state != "OPEN" then "not_open" else empty end),
      (if .isDraft == true then "draft" else empty end),
      (if .mergeable == "CONFLICTING" then "conflicts" else empty end),
      (if (.threads.unresolved // 0) > 0 then "unresolved_threads" else empty end),
      (if ((.changesRequested // []) | length) > 0 then "changes_requested" else empty end),
      (if .reviewDecision == "REVIEW_REQUIRED" then "review_required" else empty end),
      (if .ci.state == "FAILURE" or .ci.state == "ERROR" then "ci_failing" else empty end),
      (if .ci.state == "PENDING" or .ci.state == "EXPECTED" then "ci_pending" else empty end),
      (if (.ledger.mergeBlocking // 0) > 0 then "ledger_findings" else empty end),
      (if $enforce then (.approval.missing[] | select(IN("approval_required", "approval_stale", "cross_lineage_missing"))) else empty end)
    ]
  | .unknowns = [
      (if $stateok then empty else "pr_state" end),
      (if .threads == null then "threads" else empty end),
      (if $bl.lookupFailed then "reviews" else empty end),
      (if $stateok and (.ci.state | IN("SUCCESS","NONE","PENDING","EXPECTED","FAILURE","ERROR")) then empty else "ci" end),
      (if $stateok and .mergeable == "UNKNOWN" then "mergeable" else empty end),
      (if $stateok and (.mergeStateStatus | IN("BLOCKED","BEHIND")) then "merge_state" else empty end),
      (if .ledger.status | IN("unavailable", "partial") then "ledger" else empty end),
      (if $enforce and any(.approval.missing[]; IN("approval_required", "approval_stale", "cross_lineage_missing") | not)
       then "approval" else empty end)
    ]
  | .verdict = (if (.blockers | length) > 0 then "blocked"
                elif (.unknowns | length) > 0 then "unknown"
                else "ready" end)
' >"$WORK/out" || { note 'could not assemble the report'; printf '{"pr":%s,"verdict":"unknown","blockers":[],"unknowns":["pr_state","threads","reviews","ci"]}\n' "$PR_NUMBER"; exit 3; }

cat "$WORK/out"
case "$(jq -r '.verdict' "$WORK/out")" in
    ready) exit 0 ;;
    blocked) exit 1 ;;
    *) exit 3 ;;
esac
