#!/bin/bash
# Stage the resolver-touched files, commit them as a NEW commit, submit via
# the active stacked-PR provider, and verify the remote head.
# Usage: commit-resolve-fixes --provider graphite|github --pr <N> --message <msg>
#                             [--unattended] [--allow-credential-shaped]
#                             [--files-from <file>] [-- <files...>]
#   files:   repo-root-relative paths the resolvers modified, one per line in
#            --files-from and/or after --. Resolver output is untrusted, so
#            callers pass it through --files-from, never on a command line.
#            Paths must be canonical, on the PR's changed-file list and off
#            the deny list; --unattended also refuses runner files, which the
#            commit's git hooks would execute (lib/resolve-paths.sh). With
#            no files and a clean tree the result is NOOP.
#   Added lines that look like a credential are refused (exit 3, stderr
#   "credential-shaped") unless --allow-credential-shaped is passed, which an
#   interactive caller does only after the user confirms a second time.
#   The same check runs again on the commit itself: a credential a git hook
#   added is refused with exit 4 (the commit is undone), not 3.
#   --allow-credential-shaped together with --unattended is a usage error
#   (exit 2): the override needs a human.
#   message: one line starting with a conventional `fix` prefix; carries
#            counts and paths only, never reviewer text.
# Output: JSON to stdout: {"status":"PUSHED|NOOP","sha":"...","branch":"..."}
# Exit codes: 2 usage (including --allow-credential-shaped with
#             --unattended), 3 staged mismatch, refused path or
#             pre-commit credential-shaped refusal, 4 commit failed
#             (or no new commit appeared, changes remain staged, the
#             commit's files or added lines differ from the checked set
#             (including a credential a hook added), or the tree is dirty
#             after it, e.g. a hook changed or created files; the commit is
#             then undone and its changes left unstaged for the caller's
#             revert), 5 submit failed or timed out, 6 verify mismatch or a
#             verify call timed out. After 5 or 6 the commit exists locally:
#             resubmit through the provider rather than re-running this
#             script (a re-run sees a clean tree: NOOP).
# Env: YELLOW_REVIEW_GITHUB_STACK_RUNTIME — path to github-stack-runtime.js
#        (default: the sibling github-workflow plugin).
#      YELLOW_REVIEW_VERIFY_BACKOFF (default "2 4 8 16") — seconds between
#        PR head checks after the first.
#      YELLOW_REVIEW_SUBMIT_TIMEOUT (default 300) and
#      YELLOW_REVIEW_NET_TIMEOUT (default 30) — seconds allowed for the
#        provider submit and for each gh / git ls-remote call, enforced with
#        timeout(1) or gtimeout when installed (no limit otherwise). Worst
#        case with the defaults is under 600 s, the caller's Bash budget.
# Contract: references/resolve/dispositions.md. This script never pushes
# directly; the provider's submit is the only publish path.

set -euo pipefail

MAX_MESSAGE_CHARS=200

# shellcheck source=../../../lib/resolve-paths.sh
. "$(dirname -- "$0")/../../../lib/resolve-paths.sh"
# shellcheck source=../../../lib/resolve-text.sh
. "$(dirname -- "$0")/../../../lib/resolve-text.sh"

die() { printf '[commit-resolve-fixes] Error: %s\n' "$2" >&2; exit "$1"; }

usage() {
    printf 'Usage: commit-resolve-fixes --provider graphite|github --pr <N> --message <msg> [--unattended] [--allow-credential-shaped] [--files-from <file>] [-- <files...>]\n' >&2
    exit 2
}

PROVIDER=""
PR=""
MESSAGE=""
UNATTENDED=0
ALLOW_CREDENTIAL=0
while [ $# -gt 0 ]; do
    case "$1" in
        --provider) [ $# -ge 2 ] || usage; PROVIDER="$2"; shift 2 ;;
        --pr) [ $# -ge 2 ] || usage; PR="$2"; shift 2 ;;
        --message) [ $# -ge 2 ] || usage; MESSAGE="$2"; shift 2 ;;
        --unattended) UNATTENDED=1; shift ;;
        --allow-credential-shaped) ALLOW_CREDENTIAL=1; shift ;;
        --files-from)
            [ $# -ge 2 ] || usage
            rp_read_file_list "$2" || die 2 "--files-from not readable: $2"
            shift 2
            ;;
        --) shift; RP_FILES+=("$@"); break ;;
        *) usage ;;
    esac
done
FILES=(${RP_FILES[@]+"${RP_FILES[@]}"})

case "$PROVIDER" in
    graphite|github) ;;
    *) die 2 "--provider must be graphite or github" ;;
esac
[[ "$PR" =~ ^[1-9][0-9]*$ ]] || die 2 "--pr must be a positive integer"
[[ "$MESSAGE" =~ ^fix(\([a-z0-9._/-]+\))?!?:\ [^[:cntrl:]]+$ ]] \
    || die 2 "--message must be one line starting with 'fix:' or 'fix(<scope>):'"
[ "${#MESSAGE}" -le "$MAX_MESSAGE_CHARS" ] || die 2 "--message exceeds $MAX_MESSAGE_CHARS characters"
[ "$UNATTENDED" = 1 ] && [ "$ALLOW_CREDENTIAL" = 1 ] \
    && die 2 "--allow-credential-shaped needs a human confirmation; never pass it with --unattended"

for tool in git gh jq; do
    command -v "$tool" >/dev/null 2>&1 || die 2 "$tool not found"
done

# Bound every network call. Without timeout(1) or gtimeout (macOS without
# coreutils) calls run unbounded. A timeout exits 124, which every caller
# below already treats as a failure of that step.
SUBMIT_TIMEOUT="${YELLOW_REVIEW_SUBMIT_TIMEOUT:-300}"
NET_TIMEOUT="${YELLOW_REVIEW_NET_TIMEOUT:-30}"
TIMEOUT_BIN=$(command -v timeout || command -v gtimeout || true)
bounded() {
    local secs="$1"
    shift
    if [ -n "$TIMEOUT_BIN" ]; then "$TIMEOUT_BIN" "$secs" "$@"; else "$@"; fi
}
GH_BIN=$(command -v gh)
# Shadows gh for this script and the sourced rp_pr_files.
gh() { bounded "$NET_TIMEOUT" "$GH_BIN" "$@"; }

TOP=$(git rev-parse --show-toplevel 2>/dev/null) || die 2 "not inside a git repository"
cd -- "$TOP"
BRANCH=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) || die 2 "HEAD is detached; check out the PR branch"

# The github-workflow runtime sits beside this plugin: plugins/<name>/ in the
# source tree, <marketplace>/<name>/<version>/ in the installed cache.
find_runtime() {
    local root
    root=$(cd -- "$(dirname -- "$0")/../../.." && pwd) || return 1
    rp_sibling_file "$root" github-workflow lib/github-stack-runtime.js
}

if [ "$PROVIDER" = github ]; then
    RUNTIME="${YELLOW_REVIEW_GITHUB_STACK_RUNTIME:-$(find_runtime || true)}"
    command -v node >/dev/null 2>&1 || die 2 "node not found"
    [ -n "$RUNTIME" ] && [ -f "$RUNTIME" ] || die 2 "github-stack-runtime.js not found (is github-workflow installed?)"
fi

# --- Validate the expected set ---
# Arrays are expanded as ${a[@]+"${a[@]}"} so an empty one survives set -u
# under bash 3.2.
EXPECTED=()
for f in ${FILES[@]+"${FILES[@]}"}; do
    rp_canonical "$f" || die 2 "path must be canonical and repo-relative: $f"
    rp_denied "$f" && die 3 "refusing to commit a deny-listed path: $f"
    if [ "$UNATTENDED" = 1 ] && rp_runner "$f"; then
        die 3 "refusing to commit a runner file unattended (git hooks would execute it): $f"
    fi
    [ -z "$(lgit status --porcelain --untracked-files=all -- "$f")" ] \
        && die 3 "listed file has no changes: $f"
    EXPECTED+=("$f")
done

# Only files the PR already changes may be committed.
if [ "${#EXPECTED[@]}" -gt 0 ]; then
    PR_FILES=$(rp_pr_files "$PR" 2>/dev/null) || die 3 "could not list PR #$PR's changed files"
    for f in "${EXPECTED[@]}"; do
        grep -qxF -- "$f" <<<"$PR_FILES" || die 3 "not one of PR #$PR's changed files: $f"
    done
fi

# Tracked or untracked changes outside the expected set would ride along in
# the commit (or be left behind): refuse before staging anything.
DIRTY_FILE=$(mktemp) || die 2 "mktemp failed"
trap 'rm -f "$DIRTY_FILE"' EXIT
rp_tree_changes "$DIRTY_FILE" || die 3 "cannot list tree changes"
d=$(rp_assert_only_listed "$DIRTY_FILE" ${EXPECTED[@]+"${EXPECTED[@]}"}) \
    || die 3 "change outside the expected set: $d"

emit() {
    jq -nc --arg s "$1" --arg sha "$2" --arg b "$BRANCH" '{status: $s, sha: $sha, branch: $b}'
}

if [ "${#EXPECTED[@]}" -eq 0 ]; then
    emit NOOP "$(git rev-parse HEAD)"
    exit 0
fi

# --- Stage and compare ---
lgit add -- "${EXPECTED[@]}" || die 3 "git add failed"
STAGED=$(git diff --cached --no-renames --name-only -z | tr '\0' '\n' | LC_ALL=C sort)
WANT=$(printf '%s\n' "${EXPECTED[@]}" | LC_ALL=C sort -u)
if [ "$STAGED" != "$WANT" ]; then
    printf '[commit-resolve-fixes] expected:\n%s\n[commit-resolve-fixes] staged:\n%s\n' "$WANT" "$STAGED" >&2
    die 3 "staged set does not match the expected set"
fi

# A review comment can steer a resolver into pasting a secret it read into a
# file the PR already changes. Scan only added lines inside hunks (a header
# is skipped by position, so an added "++ x" line is still scanned), with
# --text so binary-attributed files are not hidden.
ADDED=$(mktemp) || die 2 "mktemp failed"
trap 'rm -f "$DIRTY_FILE" "$ADDED"' EXIT
git diff --cached --no-renames --no-color --no-ext-diff --no-textconv --text -U0 \
    | rt_added_lines >"$ADDED"
if [ "$ALLOW_CREDENTIAL" = 0 ] && rt_looks_secret "$ADDED"; then
    lgit reset -q -- "${EXPECTED[@]}"
    die 3 "credential-shaped: staged changes look like they contain a credential; nothing committed"
fi

# --- Commit (always a new commit; never amend) ---
BEFORE=$(git rev-parse HEAD)
SHA=""
# Undo the new commit (changes left unstaged) and exit 4, so nothing is
# submitted and a later submit — for example of an upstack branch — cannot
# publish it.
undo_commit() {
    git reset -q "$BEFORE" || printf '[commit-resolve-fixes] Warning: could not undo commit %s\n' "${SHA:-HEAD}" >&2
    die 4 "$1"
}
case "$PROVIDER" in
    graphite) gt modify -c -m "$MESSAGE" --no-interactive >&2 || die 4 "gt modify -c failed" ;;
    github) git commit -q -m "$MESSAGE" >&2 || die 4 "git commit failed" ;;
esac
SHA=$(git rev-parse HEAD)
[ "$(git rev-parse HEAD^)" = "$BEFORE" ] || undo_commit "no new commit was created on top of the previous HEAD"
git diff --cached --quiet || undo_commit "changes remain staged after the commit"

# A pre-commit hook can stage more files or edit listed ones after the checks
# above, so compare what the commit actually holds.
COMMITTED=$(git diff --no-renames --name-only -z "$BEFORE" "$SHA" | tr '\0' '\n' | LC_ALL=C sort)
if [ "$COMMITTED" != "$WANT" ]; then
    printf '[commit-resolve-fixes] expected:\n%s\n[commit-resolve-fixes] committed:\n%s\n' "$WANT" "$COMMITTED" >&2
    undo_commit "committed set does not match the expected set (a hook changed it); nothing submitted"
fi
git diff --no-renames --no-color --no-ext-diff --no-textconv --text -U0 "$BEFORE" "$SHA" \
    | rt_added_lines >|"$ADDED"
if [ "$ALLOW_CREDENTIAL" = 0 ] && rt_looks_secret "$ADDED"; then
    undo_commit "credential-shaped: the commit looks like it contains a credential (a hook may have added it); nothing submitted"
fi
# A hook can also leave edits or new files unstaged or untracked. Check before
# submitting, so a dirty tree is never reported after the push has happened.
if [ -n "$(git status --porcelain --untracked-files=all)" ]; then
    undo_commit "the working tree is not clean after the commit (a hook left changes behind); nothing submitted"
fi

# --- Resolve the remote once ---
# Submit and verification must agree on one remote. The github runtime is given
# it explicitly (its own default would pick remote.pushDefault over a
# branch-specific pushRemote); gt submit pushes to the branch's configured
# remote, which this precedence mirrors.
REMOTE_NAME=$(git config --get "branch.$BRANCH.pushRemote" 2>/dev/null \
    || git config --get remote.pushDefault 2>/dev/null \
    || git config --get "branch.$BRANCH.remote" 2>/dev/null || true)
# "." means a local upstream (common for stacked branches). With nothing
# configured, the providers accept a sole remote whatever its name, so use that
# one; otherwise origin.
case "$REMOTE_NAME" in
    ''|.)
        REMOTES=$(git remote 2>/dev/null || true)
        if [ -n "$REMOTES" ] && [ "$(printf '%s\n' "$REMOTES" | wc -l)" -eq 1 ]; then
            REMOTE_NAME="$REMOTES"
        else
            REMOTE_NAME=origin
        fi
        ;;
esac

# --- Submit ---
case "$PROVIDER" in
    graphite)
        # No --update-only: it has not been shown to leave the set of
        # submitted stack branches unchanged, and the PR already exists.
        bounded "$SUBMIT_TIMEOUT" gt submit --no-interactive --no-edit >&2 \
            || die 5 "gt submit failed or timed out after ${SUBMIT_TIMEOUT}s"
        ;;
    github)
        # The runtime always exits 0 and reports through its JSON status.
        OUT=$(bounded "$SUBMIT_TIMEOUT" node "$RUNTIME" submit --remote "$REMOTE_NAME") \
            || die 5 "github-stack-runtime submit crashed or timed out after ${SUBMIT_TIMEOUT}s"
        ST=$(printf '%s' "$OUT" | jq -r '.status // empty' 2>/dev/null || true)
        if [ "$ST" != SUCCESS ]; then
            printf '%s\n' "$OUT" >&2
            die 5 "github-stack-runtime submit returned status '${ST:-unparseable}'"
        fi
        ;;
esac

# --- Verify the published head ---
# The branch ref is updated synchronously by the submit; the PR's
# headRefOid can lag, so only that check backs off.
REMOTE=$(bounded "$NET_TIMEOUT" git ls-remote "$REMOTE_NAME" "refs/heads/$BRANCH" 2>/dev/null | awk 'NR == 1 { print $1 }' || true)
[ "$REMOTE" = "$SHA" ] || die 6 "head not verified: local=$SHA remote=${REMOTE:-none}"
PR_HEAD=""
for delay in 0 ${YELLOW_REVIEW_VERIFY_BACKOFF:-2 4 8 16}; do
    [ "$delay" -gt 0 ] && sleep "$delay"
    PR_HEAD=$(gh pr view "$PR" --json headRefOid 2>/dev/null | jq -r '.headRefOid // empty' 2>/dev/null || true)
    [ "$PR_HEAD" = "$SHA" ] && break
done
[ "$PR_HEAD" = "$SHA" ] || die 6 "head not verified: local=$SHA pr=${PR_HEAD:-none}"

emit PUSHED "$SHA"
