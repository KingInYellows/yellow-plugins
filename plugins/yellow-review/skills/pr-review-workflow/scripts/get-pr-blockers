#!/bin/sh
# Report what blocks a PR from merging beyond open review threads.
# Usage: get-pr-blockers <owner/repo> <pr-number>
# Output: JSON to stdout:
#   {"changesRequested":[{"login":"...","reviewId":"..."}],
#    "reviewDecision":"CHANGES_REQUESTED|APPROVED|REVIEW_REQUIRED|null",
#    "conversationResolution":"enforced|not_enforced|unknown",
#    "lookupFailed":true|false}
# Only reviews from users with write access are counted (writersOnly).
# A failed review lookup is signalled only by lookupFailed true, together
# with changesRequested null (also when there are more than 100 reviewers).
# Callers must use lookupFailed to detect it and treat true as
# blocking-unknown, never as "no blockers". reviewDecision null alone is not
# a failure: GitHub returns it when no review is required.
# conversationResolution "unknown" is independent of lookupFailed: it means
# the branch-protection or ruleset lookup was unreadable, and it can occur
# while lookupFailed is false.
# Never fails the caller: usage errors exit 2, every lookup error exits 0
# with unknown fields and a note on stderr.

set -eu

note() { printf '[get-pr-blockers] %s\n' "$1" >&2; }

unknown_json() {
    printf '{"changesRequested":null,"reviewDecision":null,"conversationResolution":"unknown","lookupFailed":true}\n'
}

if [ $# -ne 2 ]; then
    printf 'Usage: get-pr-blockers <owner/repo> <pr-number>\n' >&2
    exit 2
fi

REPO="$1"
PR_NUMBER="$2"

case "$REPO" in
    */*/*|/*|*/) printf 'Error: Invalid repo format. Expected owner/repo, got: %s\n' "$REPO" >&2; exit 2 ;;
    */*) OWNER="${REPO%%/*}"; NAME="${REPO#*/}" ;;
    *) printf 'Error: Invalid repo format. Expected owner/repo, got: %s\n' "$REPO" >&2; exit 2 ;;
esac
case "$PR_NUMBER" in
    ''|*[!0-9]*) printf 'Error: PR number must be numeric, got: %s\n' "$PR_NUMBER" >&2; exit 2 ;;
esac

if ! command -v gh >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
    note 'gh or jq not found; blockers unknown'
    unknown_json
    exit 0
fi

ERR_FILE=$(mktemp "${TMPDIR:-/tmp}/get-pr-blockers.XXXXXX") || { note 'mktemp failed; blockers unknown'; unknown_json; exit 0; }
trap 'rm -f "$ERR_FILE"' EXIT

# --- Reviews and base branch (GraphQL) ---
# latestOpinionatedReviews may include DISMISSED reviews, so select on the
# state client-side rather than trusting the connection to exclude them.
# writersOnly drops drive-by reviews from users who cannot block the merge.
# shellcheck disable=SC2016
QUERY='
query($owner: String!, $name: String!, $number: Int!) {
  repository(owner: $owner, name: $name) {
    pullRequest(number: $number) {
      baseRefName
      reviewDecision
      latestOpinionatedReviews(first: 100, writersOnly: true) {
        nodes {
          id
          state
          submittedAt
          author { __typename login }
          commit { oid }
        }
        pageInfo { hasNextPage }
      }
    }
  }
}'

CHANGES_REQUESTED=null
REVIEW_DECISION=null
LOOKUP_FAILED=true
BASE=""
RESPONSE=""
if RESPONSE=$(gh api graphql -f owner="$OWNER" -f name="$NAME" -F "number=$PR_NUMBER" \
        -f query="$QUERY" 2>"$ERR_FILE") \
    && PR_JSON=$(printf '%s' "$RESPONSE" | jq -e 'if ((.errors // []) | length) > 0 then empty else .data.repository.pullRequest | objects end' 2>/dev/null); then
    # A page past the first 100 reviewers would undercount; report unknown.
    if [ "$(printf '%s' "$PR_JSON" | jq -r '.latestOpinionatedReviews.pageInfo.hasNextPage // false')" = true ]; then
        note 'more than 100 opinionated reviewers; changesRequested unknown'
    else
        # A missing connection or a non-array nodes value is an error, not an
        # empty list. A jq failure leaves the fields unknown instead of
        # aborting under set -e.
        if CHANGES_REQUESTED=$(printf '%s' "$PR_JSON" | jq -c '
          if (.latestOpinionatedReviews.nodes | type) != "array"
          then error("review nodes missing")
          else [ .latestOpinionatedReviews.nodes[]
            | select(.state == "CHANGES_REQUESTED")
            | { login: ((.author.login // "ghost") | sub("\\[bot\\]$"; "")), reviewId: .id } ]
          end' 2>/dev/null); then
            LOOKUP_FAILED=false
        else
            CHANGES_REQUESTED=null
            note 'review nodes unreadable; changesRequested unknown'
        fi
    fi
    REVIEW_DECISION=$(printf '%s' "$PR_JSON" | jq -c '.reviewDecision' 2>/dev/null) || REVIEW_DECISION=null
    BASE=$(printf '%s' "$PR_JSON" | jq -r '.baseRefName // empty' 2>/dev/null) || BASE=""
else
    # gh can exit 0 with a null pullRequest and the reason in .errors.
    GQL_MSG=$(printf '%s' "$RESPONSE" | jq -r '.errors[0].message // empty' 2>/dev/null) || GQL_MSG=""
    note "review lookup failed; changesRequested unknown: $(head -c 300 "$ERR_FILE")${GQL_MSG:+ $GQL_MSG}"
fi

# --- Conversation resolution (REST) ---
# enforced when either classic protection or a ruleset requires it;
# not_enforced only when both sources answered and neither requires it.
CLASSIC=unknown
RULES=unknown
if [ -n "$BASE" ]; then
    BASE_ENC=$(printf '%s' "$BASE" | jq -sRr @uri 2>/dev/null) || BASE_ENC=""
fi
if [ -n "$BASE" ] && [ -z "$BASE_ENC" ]; then
    note 'base branch name could not be encoded; conversationResolution unknown'
elif [ -n "$BASE" ]; then
    if OUT=$(gh api "repos/$OWNER/$NAME/branches/$BASE_ENC/protection" \
            --jq '.required_conversation_resolution.enabled // false' 2>"$ERR_FILE"); then
        case "$OUT" in
            true) CLASSIC=true ;;
            *) CLASSIC=false ;;
        esac
    elif grep -q 'Branch not protected' "$ERR_FILE"; then
        CLASSIC=false
    else
        # 403/404 for callers without admin rights: the setting is not visible.
        note 'classic branch protection not readable; treating as unknown'
    fi

    # The endpoint returns 30 rules per page. --paginate prints one JSON array
    # per page, so combine every page with jq -s before applying any; a failed
    # page fails the whole lookup and RULES stays unknown.
    if PAGES=$(gh api --paginate "repos/$OWNER/$NAME/rules/branches/$BASE_ENC" 2>"$ERR_FILE") \
        && OUT=$(printf '%s' "$PAGES" | jq -s \
            '[.[][] | select(.type == "pull_request") | .parameters.required_review_thread_resolution] | any' \
            2>>"$ERR_FILE"); then
        case "$OUT" in
            true) RULES=true ;;
            *) RULES=false ;;
        esac
    else
        note "branch rules lookup failed: $(head -c 300 "$ERR_FILE")"
    fi
fi

if [ "$CLASSIC" = true ] || [ "$RULES" = true ]; then
    RESOLUTION=enforced
elif [ "$CLASSIC" = false ] && [ "$RULES" = false ]; then
    RESOLUTION=not_enforced
else
    RESOLUTION=unknown
fi

jq -nc \
    --argjson cr "$CHANGES_REQUESTED" \
    --argjson rd "$REVIEW_DECISION" \
    --arg res "$RESOLUTION" \
    --argjson lf "$LOOKUP_FAILED" \
    '{changesRequested: $cr, reviewDecision: $rd, conversationResolution: $res, lookupFailed: $lf}' \
    || unknown_json
