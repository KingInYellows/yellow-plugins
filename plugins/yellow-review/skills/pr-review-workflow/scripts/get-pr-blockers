#!/bin/sh
# Report what blocks a PR from merging beyond open review threads.
# Usage: get-pr-blockers <owner/repo> <pr-number>
# Output: JSON to stdout:
#   {"changesRequested":[{"login":"...","reviewId":"..."}],
#    "reviewDecision":"CHANGES_REQUESTED|APPROVED|REVIEW_REQUIRED|null",
#    "conversationResolution":"enforced|not_enforced|unknown",
#    "resolutionLookupReason":null|"rate_limited",
#    "lookupFailed":true|false,
#    "lookupReason":null|"tool_missing|timeout|rate_limited|auth|not_found|
#                         too_many_reviewers|unreadable|other"}
# Only reviews from users with write access are counted (writersOnly).
# A failed review lookup is signalled only by lookupFailed true, together
# with changesRequested null (also when there are more than 100 reviewers).
# Callers must use lookupFailed to detect it and treat true as
# blocking-unknown, never as "no blockers". lookupReason names why, and is
# null whenever lookupFailed is false; a caller that must stop on a rate limit
# keys on "rate_limited" (it sets ratelimited=1 in the Resolve: line).
# reviewDecision null alone is not a failure: GitHub returns it when no review
# is required.
# conversationResolution is read from the PR's base branch and, when that is
# not the default branch (a PR upstack in a stack), from the default branch
# too: enforced when either enforces it, not_enforced only when every branch
# read answered no, unknown otherwise. It is independent of lookupFailed: it
# means the branch-protection or ruleset lookup was unreadable, and it can
# occur while lookupFailed is false.
# resolutionLookupReason is "rate_limited" when any of those branch-protection
# or ruleset reads hit a rate limit (conversationResolution is then usually
# unknown, with lookupFailed false), and null otherwise. A caller that must
# stop on a rate limit keys on this field as well as on lookupReason.
# Never fails the caller: usage errors exit 2, every lookup error exits 0
# with unknown fields and a note on stderr. That includes a gh call that
# exceeds YELLOW_REVIEW_GH_TIMEOUT (default 30 s, clamped to 60, needs timeout(1) or
# gtimeout(1); see
# lib/resolve-gh.sh): it is treated like any other failed lookup.

set -eu

note() { printf '[get-pr-blockers] %s\n' "$1" >&2; }

# unknown_json <reason>: <reason> is one of the fixed lookupReason tokens.
unknown_json() {
    printf '{"changesRequested":null,"reviewDecision":null,"conversationResolution":"unknown","resolutionLookupReason":null,"lookupFailed":true,"lookupReason":"%s"}\n' "$1"
}

if [ $# -ne 2 ]; then
    printf 'Usage: get-pr-blockers <owner/repo> <pr-number>\n' >&2
    exit 2
fi

REPO="$1"
PR_NUMBER="$2"

case "$REPO" in
    */*/*|/*|*/) printf 'Error: Invalid repo format. Expected owner/repo, got: %s\n' "$REPO" >&2; exit 2 ;;
    */*) OWNER="${REPO%%/*}"; NAME="${REPO#*/}" ;;
    *) printf 'Error: Invalid repo format. Expected owner/repo, got: %s\n' "$REPO" >&2; exit 2 ;;
esac
case "$PR_NUMBER" in
    ''|*[!0-9]*) printf 'Error: PR number must be numeric, got: %s\n' "$PR_NUMBER" >&2; exit 2 ;;
esac

if ! command -v gh >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
    note 'gh or jq not found; blockers unknown'
    unknown_json tool_missing
    exit 0
fi

# A missing or unreadable library must not abort under set -eu: a failed `.`
# exits a non-interactive shell, so test the file first and keep the exit-0
# contract.
RESOLVE_GH_LIB="$(dirname -- "$0")/../../../lib/resolve-gh.sh"
if [ ! -r "$RESOLVE_GH_LIB" ]; then
    note "cannot read $RESOLVE_GH_LIB; blockers unknown"
    unknown_json other
    exit 0
fi
# shellcheck source=../../../lib/resolve-gh.sh
. "$RESOLVE_GH_LIB"

timeout_note() {
    if [ "$1" -eq 124 ]; then note "gh timed out after ${RG_GH_TIMEOUT}s on the $2 lookup"; fi
}

ERR_FILE=$(mktemp "${TMPDIR:-/tmp}/get-pr-blockers.XXXXXX") || { note 'mktemp failed; blockers unknown'; unknown_json other; exit 0; }
RATE_FILE="$ERR_FILE.rl"
trap 'rm -f "$ERR_FILE" "$RATE_FILE"' EXIT

# --- Reviews, base branch and default branch (GraphQL) ---
# latestOpinionatedReviews may include DISMISSED reviews, so select on the
# state client-side rather than trusting the connection to exclude them.
# writersOnly drops drive-by reviews from users who cannot block the merge.
# shellcheck disable=SC2016
QUERY='
query($owner: String!, $name: String!, $number: Int!) {
  repository(owner: $owner, name: $name) {
    defaultBranchRef { name }
    pullRequest(number: $number) {
      baseRefName
      reviewDecision
      latestOpinionatedReviews(first: 100, writersOnly: true) {
        nodes {
          id
          state
          author { login }
        }
        pageInfo { hasNextPage }
      }
    }
  }
}'

CHANGES_REQUESTED=null
REVIEW_DECISION=null
LOOKUP_FAILED=true
LOOKUP_REASON=other
BASE=""
DEFAULT_BRANCH=""
RESPONSE=""
REVIEW_RC=0
RESPONSE=$(rg_gh api graphql -f owner="$OWNER" -f name="$NAME" -F "number=$PR_NUMBER" \
    -f query="$QUERY" 2>"$ERR_FILE") || REVIEW_RC=$?
if [ "$REVIEW_RC" -eq 0 ] \
    && PR_JSON=$(printf '%s' "$RESPONSE" | jq -e 'if ((.errors // []) | length) > 0 then empty else .data.repository.pullRequest | objects end' 2>/dev/null); then
    # A page past the first 100 reviewers would undercount; report unknown.
    if [ "$(printf '%s' "$PR_JSON" | jq -r '.latestOpinionatedReviews.pageInfo.hasNextPage // false')" = true ]; then
        LOOKUP_REASON=too_many_reviewers
        note 'more than 100 opinionated reviewers; changesRequested unknown'
    else
        # A missing connection or a non-array nodes value is an error, not an
        # empty list. A jq failure leaves the fields unknown instead of
        # aborting under set -e.
        if CHANGES_REQUESTED=$(printf '%s' "$PR_JSON" | jq -c '
          if (.latestOpinionatedReviews.nodes | type) != "array"
          then error("review nodes missing")
          else [ .latestOpinionatedReviews.nodes[]
            | select(.state == "CHANGES_REQUESTED")
            | { login: ((.author.login // "ghost") | sub("\\[bot\\]$"; "")), reviewId: .id } ]
          end' 2>/dev/null); then
            LOOKUP_FAILED=false
            LOOKUP_REASON=""
        else
            CHANGES_REQUESTED=null
            LOOKUP_REASON=unreadable
            note 'review nodes unreadable; changesRequested unknown'
        fi
    fi
    REVIEW_DECISION=$(printf '%s' "$PR_JSON" | jq -c '.reviewDecision' 2>/dev/null) || REVIEW_DECISION=null
    BASE=$(printf '%s' "$PR_JSON" | jq -r '.baseRefName // empty' 2>/dev/null) || BASE=""
    DEFAULT_BRANCH=$(printf '%s' "$RESPONSE" | jq -r '.data.repository.defaultBranchRef.name // empty' 2>/dev/null) || DEFAULT_BRANCH=""
else
    # gh can exit 0 with a null pullRequest and the reason in .errors; keep
    # that message with gh's own stderr so one classifier reads both.
    GQL_MSG=$(printf '%s' "$RESPONSE" | jq -r '.errors[0].message // empty' 2>/dev/null) || GQL_MSG=""
    printf '%s\n' "$GQL_MSG" >>"$ERR_FILE"
    timeout_note "$REVIEW_RC" review
    if [ "$REVIEW_RC" -eq 124 ]; then
        LOOKUP_REASON=timeout
    elif rg_is_rate_limited "$ERR_FILE"; then
        LOOKUP_REASON=rate_limited
    elif rg_is_auth_failure "$ERR_FILE"; then
        LOOKUP_REASON=auth
    elif grep -qiE 'Could not resolve to|NOT_FOUND|HTTP 404' "$ERR_FILE"; then
        LOOKUP_REASON=not_found
    fi
    note "review lookup failed ($LOOKUP_REASON); changesRequested unknown: $(head -c 300 "$ERR_FILE" | tr '\n' ' ')"
fi

# --- Conversation resolution (REST) ---
# branch_resolution <branch>: enforced when either classic protection or a
# ruleset requires conversation resolution on the branch; not_enforced only
# when both sources answered and neither requires it; unknown otherwise.
# Runs in a command substitution, so a rate-limited read is recorded by
# creating $RATE_FILE rather than by setting a variable.
branch_resolution() {
    _classic=unknown
    _rules=unknown
    _enc=$(printf '%s' "$1" | jq -sRr @uri)
    _classic_rc=0
    _out=$(rg_gh api "repos/$OWNER/$NAME/branches/$_enc/protection" \
        --jq '.required_conversation_resolution.enabled // false' 2>"$ERR_FILE") || _classic_rc=$?
    if [ "$_classic_rc" -eq 0 ]; then
        case "$_out" in
            true) _classic=true ;;
            *) _classic=false ;;
        esac
    elif grep -q 'Branch not protected' "$ERR_FILE"; then
        _classic=false
    else
        timeout_note "$_classic_rc" 'classic branch protection'
        if rg_is_rate_limited "$ERR_FILE"; then : >"$RATE_FILE"; fi
        # 403/404 for callers without admin rights: the setting is not visible.
        note "classic branch protection of $1 not readable; treating as unknown"
    fi

    # The endpoint returns 30 rules per page. --paginate prints one JSON array
    # per page, so combine every page with jq -s before applying any; a failed
    # page fails the whole lookup and the rules stay unknown.
    _rules_rc=0
    _pages=$(rg_gh api --paginate "repos/$OWNER/$NAME/rules/branches/$_enc" 2>"$ERR_FILE") || _rules_rc=$?
    if [ "$_rules_rc" -eq 0 ] \
        && _out=$(printf '%s' "$_pages" | jq -s \
            '[.[][] | select(.type == "pull_request") | .parameters.required_review_thread_resolution] | any' \
            2>>"$ERR_FILE"); then
        case "$_out" in
            true) _rules=true ;;
            *) _rules=false ;;
        esac
    else
        timeout_note "$_rules_rc" 'branch rules'
        if rg_is_rate_limited "$ERR_FILE"; then : >"$RATE_FILE"; fi
        note "branch rules lookup of $1 failed: $(head -c 300 "$ERR_FILE")"
    fi

    if [ "$_classic" = true ] || [ "$_rules" = true ]; then
        printf 'enforced'
    elif [ "$_classic" = false ] && [ "$_rules" = false ]; then
        printf 'not_enforced'
    else
        printf 'unknown'
    fi
}

# A PR upstack in a stack has a parent branch as its base, and that branch
# usually has no protection of its own: the default branch is what the stack
# lands on, so read it too.
RESOLUTION=unknown
if [ -n "$BASE" ]; then
    BASE_RESOLUTION=$(branch_resolution "$BASE")
    TRUNK_RESOLUTION=$BASE_RESOLUTION
    if [ -n "$DEFAULT_BRANCH" ] && [ "$DEFAULT_BRANCH" != "$BASE" ]; then
        TRUNK_RESOLUTION=$(branch_resolution "$DEFAULT_BRANCH")
    fi
    if [ "$BASE_RESOLUTION" = enforced ] || [ "$TRUNK_RESOLUTION" = enforced ]; then
        RESOLUTION=enforced
    elif [ "$BASE_RESOLUTION" = not_enforced ] && [ "$TRUNK_RESOLUTION" = not_enforced ]; then
        RESOLUTION=not_enforced
    fi
fi

RESOLUTION_REASON=""
if [ -e "$RATE_FILE" ]; then RESOLUTION_REASON=rate_limited; fi

jq -nc \
    --argjson cr "$CHANGES_REQUESTED" \
    --argjson rd "$REVIEW_DECISION" \
    --arg res "$RESOLUTION" \
    --argjson lf "$LOOKUP_FAILED" \
    --arg lr "$LOOKUP_REASON" \
    --arg rr "$RESOLUTION_REASON" \
    '{changesRequested: $cr, reviewDecision: $rd, conversationResolution: $res,
      resolutionLookupReason: (if $rr == "" then null else $rr end),
      lookupFailed: $lf, lookupReason: (if $lr == "" then null else $lr end)}'
