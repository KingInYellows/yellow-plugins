#!/bin/sh
# Reply to a PR review thread with an idempotency marker.
# Usage: reply-pr-thread <PRRT_id> <disposition> <body-file>
#   disposition: fixed | addressed | oos | disagree | unclear
#   body-file:   reply text, at most 1000 characters; the marker is appended
# Output: JSON to stdout:
#   {"replied":true,"commentId":"PRRC_...","threadId":"PRRT_..."}
#   {"replied":false,"skipped":"already-replied","disposition":"...","threadId":"PRRT_..."}
#     (skipped when the thread's last comment is ours and carries a marker
#     for this thread; "disposition" is the one found. The one exception: a
#     prior disagree or unclear marker never blocks a fixed, addressed or oos
#     reply, because that reply carries the evidence the later resolve needs.
#     A caller resolves after a skip only when "disposition" equals the one
#     it asked for.)
# Concurrency: the marker makes re-runs idempotent, not the pre-check and
#   the reply atomic. Two runs as the same viewer that reach one thread at
#   the same moment can both pass the pre-check and both post, possibly with
#   different dispositions; this script does not detect that after the write
#   (it has no lock, no post-write rescan and never deletes a comment). Run
#   one resolve or sweep per PR at a time. A later re-run reads only the last
#   comment and reports its disposition in the skip, so the caller's
#   disposition check still guards the resolve.
# Exit codes: 1 other failure (including a non-JSON response),
#             2 usage: wrong argument count, invalid thread ID or
#               disposition, unreadable, empty or over-long body file, or a
#               body that looks like a credential (or could not be scanned).
#               A refusal prints a `resolve-text:` line, never the text:
#               `refused rule=<rule> line=<n>` for a credential hit,
#               `scan failed` when the scan did not run. Look for that line
#               anywhere on stderr; it is not always first,
#             3 not found or permission,
#             4 rate limited or timed out: a second rate limit after the one
#               retry the whole script gets, a wait over 90 s (the wait is
#               Retry-After, else x-ratelimit-reset when
#               x-ratelimit-remaining is 0, else
#               YELLOW_REVIEW_RATE_LIMIT_WAIT), or a gh call that exceeded
#               YELLOW_REVIEW_GH_TIMEOUT (not retried: the reply may have
#               posted; a re-run skips via the pre-check).
# Contract: references/resolve/dispositions.md
# Env: YELLOW_REVIEW_PACE_SECONDS (default 1) — sleep after the mutation.
#      YELLOW_REVIEW_RATE_LIMIT_WAIT (default 60) — wait when no header says.
#      YELLOW_REVIEW_GH_TIMEOUT (default 30) — seconds per gh call; needs
#        timeout(1) or gtimeout(1), skipped with a stderr note when neither
#        is installed.

set -eu

MAX_BODY_CHARS=1000
# Longer waits exit 4 instead. This caps the wait only: the worst case is
# the pre-check, the wait, the retried pre-check and the reply, each gh call
# up to GH_TIMEOUT (30 + 90 + 30 + 30 = 180 s by default), so a caller that
# must survive it passes a Bash tool timeout above that, not the 120 s default.
MAX_WAIT_SECONDS=90
GH_TIMEOUT="${YELLOW_REVIEW_GH_TIMEOUT:-30}"
case "$GH_TIMEOUT" in ''|*[!0-9]*) GH_TIMEOUT=30 ;; esac
# timeout(1) treats 0 as "no limit"; fall back to the default instead.
[ "$GH_TIMEOUT" -gt 0 ] 2>/dev/null || GH_TIMEOUT=30
# GNU coreutils on macOS installs it as gtimeout.
TIMEOUT_BIN=""
for _t in timeout gtimeout; do
    if command -v "$_t" >/dev/null 2>&1; then TIMEOUT_BIN=$_t; break; fi
done
[ -n "$TIMEOUT_BIN" ] || printf 'Note: neither timeout nor gtimeout is installed; gh calls run without a time limit.\n' >&2

usage() {
    printf 'Usage: reply-pr-thread <PRRT_id> <fixed|addressed|oos|disagree|unclear> <body-file>\n' >&2
    exit 2
}

command -v gh >/dev/null 2>&1 || { printf 'Error: gh CLI not found.\n' >&2; exit 1; }
command -v jq >/dev/null 2>&1 || { printf 'Error: jq not found.\n' >&2; exit 1; }

[ $# -eq 3 ] || usage
THREAD_ID="$1"
DISPOSITION="$2"
BODY_FILE="$3"

case "$THREAD_ID" in
    PRRT_*) ;;
    *) printf 'Error: Invalid thread ID format. Expected PRRT_ prefix, got: %s\n' "$THREAD_ID" >&2; exit 2 ;;
esac
case "${THREAD_ID#PRRT_}" in
    ''|*[!A-Za-z0-9_-]*) printf 'Error: Invalid characters in thread ID: %s\n' "$THREAD_ID" >&2; exit 2 ;;
esac
case "$DISPOSITION" in
    fixed|addressed|oos|disagree|unclear) ;;
    *) printf 'Error: Unknown disposition: %s\n' "$DISPOSITION" >&2; exit 2 ;;
esac
[ -f "$BODY_FILE" ] && [ -r "$BODY_FILE" ] || { printf 'Error: Body file not readable: %s\n' "$BODY_FILE" >&2; exit 2; }

# Character count (not bytes), trailing whitespace ignored.
BODY_CHARS=$(jq -Rs 'sub("\\s+$"; "") | length' <"$BODY_FILE")
if [ "$BODY_CHARS" -eq 0 ]; then
    printf 'Error: Body file is empty.\n' >&2
    exit 2
fi
if [ "$BODY_CHARS" -gt "$MAX_BODY_CHARS" ]; then
    printf 'Error: Reply body is %s characters; the limit is %s.\n' "$BODY_CHARS" "$MAX_BODY_CHARS" >&2
    exit 2
fi
# shellcheck source=../../../lib/resolve-text.sh
. "$(dirname -- "$0")/../../../lib/resolve-text.sh"
if ! rt_text_clean "$BODY_FILE"; then
    rt_report_refusal
    printf 'Error: Reply body looks like it contains a credential, or could not be scanned; refusing to post it.\n' >&2
    exit 2
fi

MARKER="<!-- yellow-review:resolve v1 thread=$THREAD_ID disposition=$DISPOSITION -->"

WORK_DIR=$(mktemp -d) || { printf 'Error: mktemp failed.\n' >&2; exit 1; }
trap 'rm -rf "$WORK_DIR"' EXIT
OUT="$WORK_DIR/out"
ERR="$WORK_DIR/err"
HEADERS="$WORK_DIR/headers"
RESP="$WORK_DIR/body"
POST_BODY="$WORK_DIR/post-body"

jq -Rrs --arg marker "$MARKER" 'sub("\\s+$"; "") + "\n\n" + $marker' <"$BODY_FILE" >"$POST_BODY"

# Run `gh api -i graphql ...`; split headers and body into $HEADERS/$RESP.
# Returns gh's exit code (124 when timeout(1) killed it); also in GH_EC.
GH_EC=0
gh_graphql() {
    _ec=0
    : >"$HEADERS"
    : >"$RESP"
    if [ -n "$TIMEOUT_BIN" ]; then
        "$TIMEOUT_BIN" "$GH_TIMEOUT" gh api -i graphql "$@" >"$OUT" 2>"$ERR" || _ec=$?
    else
        gh api -i graphql "$@" >"$OUT" 2>"$ERR" || _ec=$?
    fi
    GH_EC=$_ec
    tr -d '\r' <"$OUT" | awk -v h="$HEADERS" -v b="$RESP" '
        !done && /^$/ { done = 1; next }
        !done { print > h; next }
        { print > b }
    '
    return "$_ec"
}

header() {
    awk -v name="$1" '
        tolower(substr($0, 1, length(name) + 1)) == tolower(name) ":" {
            sub(/^[^:]*:[ \t]*/, ""); print; exit
        }' "$HEADERS"
}

is_rate_limited() {
    grep -qiE 'rate limit|abuse|HTTP 429' "$ERR" && return 0
    jq -e '[.errors[]?.message // empty] | any(test("rate limit|abuse"; "i"))' "$RESP" >/dev/null 2>&1
}

is_not_found_or_forbidden() {
    grep -qiE 'Could not resolve to|NOT_FOUND|HTTP 403|HTTP 404|FORBIDDEN|Resource not accessible' "$ERR" && return 0
    jq -e '[.errors[]?.type // empty] | any(. == "NOT_FOUND" or . == "FORBIDDEN")' "$RESP" >/dev/null 2>&1
}

# Seconds to wait before the single retry: Retry-After, then the reset time
# when no requests remain, then the default. The caller compares the result
# with MAX_WAIT_SECONDS.
rate_limit_wait() {
    _wait=$(header retry-after)
    case "$_wait" in ''|*[!0-9]*) _wait="" ;; esac
    if [ -z "$_wait" ] && [ "$(header x-ratelimit-remaining)" = 0 ]; then
        _reset=$(header x-ratelimit-reset)
        case "$_reset" in
            ''|*[!0-9]*) ;;
            *) _wait=$((_reset - $(date +%s))); [ "$_wait" -ge 0 ] || _wait=0 ;;
        esac
    fi
    if [ -z "$_wait" ]; then
        _wait="${YELLOW_REVIEW_RATE_LIMIT_WAIT:-60}"
        case "$_wait" in ''|*[!0-9]*) _wait=60 ;; esac
    fi
    printf '%s' "$_wait"
}

# Run a GraphQL call; one rate-limit retry is shared by the whole script so
# the call fits the caller's Bash timeout. Exits 3/4/1 on failure.
RETRIED=0
call_with_retry() {
    _label="$1"; shift
    while :; do
        if gh_graphql "$@" && jq -e '(.errors // []) | length == 0' "$RESP" >/dev/null 2>&1; then
            return 0
        fi
        if [ "$GH_EC" -eq 124 ]; then
            printf 'Error: gh timed out after %ss on %s for %s; not retried.\n' "$GH_TIMEOUT" "$_label" "$THREAD_ID" >&2
            exit 4
        fi
        if is_rate_limited; then
            _w=$(rate_limit_wait)
            if [ "$_w" -gt "$MAX_WAIT_SECONDS" ]; then
                printf 'Error: GitHub rate limit on %s for %s; the %ss wait is over the %ss cap, not retried.\n' "$_label" "$THREAD_ID" "$_w" "$MAX_WAIT_SECONDS" >&2
                exit 4
            fi
            if [ "$RETRIED" = 1 ]; then
                printf 'Error: GitHub rate limit on %s for %s; the one retry is already spent (would wait %ss).\n' "$_label" "$THREAD_ID" "$_w" >&2
                exit 4
            fi
            printf '[reply-pr-thread] Rate limited on %s; retrying in %ss.\n' "$_label" "$_w" >&2
            sleep "$_w"
            RETRIED=1
            continue
        fi
        if is_not_found_or_forbidden; then
            printf 'Error: Thread not found or not permitted (%s): %s\n' "$_label" "$THREAD_ID" >&2
            exit 3
        fi
        # Non-JSON output (an HTML 502 page, say) has no .errors; show it.
        _detail=$(head -c 300 "$ERR")
        [ -n "$_detail" ] || _detail=$(head -c 300 "$RESP")
        printf 'Error: GraphQL %s failed for %s: %s\n' "$_label" "$THREAD_ID" "$_detail" >&2
        exit 1
    done
}

# --- Pre-check: skip when our last comment already carries a marker ---
# shellcheck disable=SC2016
PRECHECK='
query ReplyPrecheck($threadId: ID!) {
  node(id: $threadId) {
    ... on PullRequestReviewThread {
      id
      comments(last: 1) { nodes { viewerDidAuthor body } }
    }
  }
}'
call_with_retry precheck -f threadId="$THREAD_ID" -f query="$PRECHECK"

if ! jq -e '.data.node.id' "$RESP" >/dev/null 2>&1; then
    printf 'Error: Thread not found: %s\n' "$THREAD_ID" >&2
    exit 3
fi

# A marker counts only on a comment the viewer authored; a reviewer quoting
# our marker never causes a skip. Any disposition counts: a re-run after a
# crash (reply posted, resolve failed) must not post a contradictory reply.
# The exception is an upgrade from a reply that left the thread open
# (disagree, unclear) to one that lets the caller resolve it (fixed,
# addressed, oos): skipping would resolve the thread with no evidence posted.
# No match prints nothing and exits 0; a jq failure must not read as "no
# marker", or the reply the marker exists to prevent would be posted.
if ! PRIOR_DISPOSITION=$(jq -r --arg thread "$THREAD_ID" '
    .data.node.comments.nodes[-1]
    | select(. != null and .viewerDidAuthor == true)
    | (.body // "") | sub("\\s+$"; "")
    | capture("<!-- yellow-review:resolve v1 thread=" + $thread + " disposition=(?<d>fixed|addressed|oos|disagree|unclear) -->$")
    | .d
  ' "$RESP" 2>/dev/null); then
    printf 'Error: could not read the last comment of %s; not posting.\n' "$THREAD_ID" >&2
    exit 1
fi
case "$PRIOR_DISPOSITION:$DISPOSITION" in
    disagree:fixed|disagree:addressed|disagree:oos|unclear:fixed|unclear:addressed|unclear:oos)
        PRIOR_DISPOSITION="" ;;
esac
if [ -n "$PRIOR_DISPOSITION" ]; then
    jq -nc --arg id "$THREAD_ID" --arg d "$PRIOR_DISPOSITION" '{replied: false, skipped: "already-replied", disposition: $d, threadId: $id}'
    exit 0
fi

# --- Post the reply ---
# shellcheck disable=SC2016
MUTATION='
mutation ReplyToThread($threadId: ID!, $body: String!) {
  addPullRequestReviewThreadReply(input: { pullRequestReviewThreadId: $threadId, body: $body }) {
    comment { id }
  }
}'
call_with_retry reply -f threadId="$THREAD_ID" -F "body=@$POST_BODY" -f query="$MUTATION"
# The reply is already posted: a bad pacing value must not fail the script,
# or a retry would post a duplicate.
sleep "${YELLOW_REVIEW_PACE_SECONDS:-1}" 2>/dev/null || true

COMMENT_ID=$(jq -r '.data.addPullRequestReviewThreadReply.comment.id // empty' "$RESP")
if [ -z "$COMMENT_ID" ]; then
    printf 'Error: Reply mutation returned no comment for %s.\n' "$THREAD_ID" >&2
    exit 1
fi
jq -nc --arg id "$THREAD_ID" --arg cid "$COMMENT_ID" '{replied: true, commentId: $cid, threadId: $id}'
