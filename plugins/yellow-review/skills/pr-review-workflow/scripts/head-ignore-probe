#!/bin/bash
# Judge whether the PR head ignores yellow-plugins.local.md, before
# /review:sweep checks the head out (Step 1b). The head's root tree and its
# root .gitignore and .gitattributes blobs are read through the GitHub API at
# the head commit (headRefOid): no remote, fetch or checkout, so a fork PR and
# a shallow clone work the same. The API host, owner and repository come from
# the PR's own URL, so a GitHub Enterprise remote is read on its own host. Only the root .gitignore can decide a root
# path. The blobs are written as data into a temp work tree and judged by
# git against this clone's own git dir, so .git/info/exclude and
# core.excludesFile still apply. Nothing from the head is executed.
# Usage: head-ignore-probe <PR#>
# Output (stdout, one line):
#   head=tracked sha=<oid>    the head commit has yellow-plugins.local.md at the root
#   head=ignored sha=<oid>    the head's rules (with this clone's) ignore it
#   head=unignored sha=<oid>  they do not
#   (<oid> is the headRefOid judged, so the caller can bind the result to the
#   commit it checks out)
#   error=<class>    on failure; stderr says why (gh's own stderr, at most
#                    five lines, control characters removed, is forwarded)
# Exit codes:
#   0 a head= line
#   2 usage, not inside a git repository, or jq missing
#   3 systemic, so a batch caller stops: rate-limited (tested before any 403),
#     auth, forbidden (a 403 that is not a rate limit, or a 404 from the tree
#     or blob read: a token without Contents read is refused on every PR, and
#     GitHub can report that as 404 on a private repository), network (a
#     timeout, or a gh failure that is neither a 404 nor a 403), local (git
#     itself failed here), local-attributes (this clone's info/attributes or
#     core.attributesFile alone sets a content-transforming attribute on
#     .gitignore and the head does not clear it, which would refuse every PR
#     the same way)
#   4 this PR only, so a batch caller skips it: not-found (gh pr view found no
#     such pull request; only that call's 404 is PR-specific), unreadable (a malformed or truncated answer or URL, a head entry that is not a
#     regular-file blob), symlink (.gitignore or .gitattributes is a symlink,
#     which git does not read), case-alias (a root entry that differs from
#     .gitignore, .gitattributes or yellow-plugins.local.md only in ASCII case,
#     or any non-ASCII root entry name: a case-insensitive filesystem may fold
#     either onto one of those files, and Unicode folding is not ASCII's),
#     attributes (the head's .gitattributes gives .gitignore a
#     content-transforming attribute, so the checked-out file would not be
#     the blob)
# Every gh call runs under timeout(1) or gtimeout(1) when one is installed
# (lib/resolve-gh.sh, YELLOW_REVIEW_GH_TIMEOUT).

set -uo pipefail

# This script's directory by parameter expansion, not dirname.
case "$0" in
    */*) HIP_DIR=${0%/*}; [ -n "$HIP_DIR" ] || HIP_DIR=/ ;;
    *) HIP_DIR=. ;;
esac
# shellcheck source=../../../lib/resolve-gh.sh
. "$HIP_DIR/../../../lib/resolve-gh.sh" || { printf '[head-ignore-probe] Error: cannot load lib/resolve-gh.sh\n' >&2; exit 2; }

usage() { printf 'Usage: head-ignore-probe <PR#>\n' >&2; exit 2; }
[ $# -eq 1 ] || usage
PR=$1
[[ "$PR" =~ ^[1-9][0-9]*$ ]] || usage
command -v jq >/dev/null 2>&1 || { printf '[head-ignore-probe] Error: jq not found\n' >&2; exit 2; }
TOP=$(git rev-parse --show-toplevel 2>/dev/null) || { printf '[head-ignore-probe] Error: not inside a git repository\n' >&2; exit 2; }
GD=$(git -C "$TOP" rev-parse --absolute-git-dir 2>/dev/null) || { printf '[head-ignore-probe] Error: cannot resolve the git dir\n' >&2; exit 2; }

WORK=$(mktemp -d) || { printf '[head-ignore-probe] Error: mktemp failed\n' >&2; exit 2; }
trap 'rm -rf -- "$WORK"' EXIT
ERR="$WORK/err"
WT="$WORK/wt"
mkdir -- "$WT" || exit 2

# fail <exit> <class> <message>
fail() {
    printf 'error=%s\n' "$2"
    printf '[head-ignore-probe] Error: %s\n' "$3" >&2
    exit "$1"
}

# gh_call <out-file> <gh args...>: run gh into <out-file>, or classify the
# failure and exit. A rate limit is tested before a permission failure: a
# secondary rate limit is also an HTTP 403.
# A 404 is PR-specific only before API_STAGE is set: pr view has then shown
# the PR and its head commit exist, so a later 404 on the base repository's
# tree or blob endpoints is a hidden permission failure, not this PR's.
API_STAGE=0
gh_call() {
    local out=$1 rc=0
    shift
    rg_gh "$@" >|"$out" 2>|"$ERR" || rc=$?
    [ "$rc" -ne 0 ] || return 0
    [ ! -s "$ERR" ] || sed -n '1,5p' "$ERR" | tr -d '\000-\010\013-\037\177' >&2
    [ "$rc" -ne 124 ] || fail 3 network "a gh call timed out"
    rg_is_rate_limited "$ERR" && fail 3 rate-limited "GitHub API rate limit"
    rg_is_auth_failure "$ERR" && fail 3 auth "gh is not authenticated"
    if grep -qiE 'HTTP 404|Not Found|Could not resolve to a PullRequest' "$ERR"; then
        [ "$API_STAGE" -eq 0 ] || fail 3 forbidden "GitHub answered 404 for the PR head's contents, which it also answers for a token without Contents read"
        fail 4 not-found "PR #$PR was not found"
    fi
    rg_is_permission_denied "$ERR" && fail 3 forbidden "GitHub refused access to this repository's contents"
    fail 3 network "a gh call failed (exit $rc)"
}

is_oid() { [[ "$1" =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ ]]; }

gh_call "$WORK/pr" pr view "$PR" --json headRefOid,url
SHA=$(jq -r '.headRefOid // empty' "$WORK/pr" 2>/dev/null)
is_oid "$SHA" || fail 4 unreadable "PR #$PR's head commit id is malformed"
# gh api takes its host from GH_HOST or its default, not from the remote, so
# read the host and repository from the PR URL and pass them explicitly.
URL=$(jq -r '.url // empty' "$WORK/pr" 2>/dev/null)
[[ "$URL" =~ ^https://([A-Za-z0-9.-]+(:[0-9]+)?)/([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)/pull/([1-9][0-9]*)$ ]] \
    || fail 4 unreadable "PR #$PR's URL is malformed"
HOST=${BASH_REMATCH[1]}
NWO=${BASH_REMATCH[3]}
[ "${BASH_REMATCH[4]}" = "$PR" ] || fail 4 unreadable "PR #$PR's URL names another PR"
[[ ! "$NWO" =~ (^|/)\.\.?(/|$) ]] || fail 4 unreadable "PR #$PR's URL is malformed"
REPO_PATH="repos/$NWO"
API_STAGE=1

# The root listing only (non-recursive): it is never truncated in practice,
# and a truncated or malformed one is refused. GitHub always sends
# `truncated`, so a listing without it (an altering proxy) is refused too.
gh_call "$WORK/tree" api --hostname "$HOST" "$REPO_PATH/git/trees/$SHA"
jq -e '(.tree | type) == "array" and .truncated == false' "$WORK/tree" >/dev/null 2>&1 \
    || fail 4 unreadable "the PR head's root listing is malformed or truncated"

ALIASES=$(jq -r '[.tree[].path
    | select(ascii_downcase as $l | $l == ".gitignore" or $l == ".gitattributes" or $l == "yellow-plugins.local.md")
    | select(. != ".gitignore" and . != ".gitattributes" and . != "yellow-plugins.local.md")] | length' "$WORK/tree" 2>/dev/null) \
    || fail 4 unreadable "the PR head's root listing is malformed"
[ "$ALIASES" = 0 ] || fail 4 case-alias "the PR head has a root entry that differs from .gitignore, .gitattributes or yellow-plugins.local.md only in case, which a case-insensitive filesystem treats as that file"
# APFS folds non-ASCII letters too (U+017F folds to s), so a non-ASCII root
# name could be the config under another spelling. Refuse rather than fold.
NONASCII=$(jq -r '[.tree[].path | select(explode | any(. > 127))] | length' "$WORK/tree" 2>/dev/null) \
    || fail 4 unreadable "the PR head's root listing is malformed"
[ "$NONASCII" = 0 ] || fail 4 case-alias "the PR head has a non-ASCII root entry name, which a case-insensitive filesystem may fold onto .gitignore, .gitattributes or yellow-plugins.local.md"

if jq -e 'any(.tree[]; .path == "yellow-plugins.local.md")' "$WORK/tree" >/dev/null 2>&1; then
    printf 'head=tracked sha=%s\n' "$SHA"
    exit 0
fi

# fetch_entry <name>: write the head's root <name> into the temp work tree.
# Returns 1 when the head has none.
fetch_entry() {
    local e mode rest type sha
    e=$(jq -r --arg p "$1" 'first(.tree[] | select(.path == $p) | "\(.mode) \(.type) \(.sha)") // empty' "$WORK/tree" 2>/dev/null) \
        || fail 4 unreadable "the PR head's root listing is malformed"
    [ -n "$e" ] || return 1
    mode=${e%% *}
    rest=${e#* }
    type=${rest%% *}
    sha=${rest#* }
    case "$mode" in
        120000) fail 4 symlink "$1 on the PR head is a symlink, which git does not read" ;;
        100644 | 100755) ;;
        *) fail 4 unreadable "$1 on the PR head is not a regular file" ;;
    esac
    if [ "$type" != blob ] || ! is_oid "$sha"; then
        fail 4 unreadable "$1 on the PR head is not a readable blob"
    fi
    gh_call "$WT/$1" api --hostname "$HOST" -H 'Accept: application/vnd.github.raw+json' "$REPO_PATH/git/blobs/$sha"
}

# git against this clone's git dir with the temp tree as the work tree and an
# empty index, so neither this branch's files nor its index can answer.
hgit() {
    GIT_INDEX_FILE="$WORK/index" git -C "$WT" --git-dir="$GD" --work-tree="$WT" -c core.fsmonitor=false "$@"
}

# attrs_bad: 0 when .gitignore in the temp work tree has a content-transforming
# attribute, 1 when it has none. Exits 3 when git fails.
attrs_bad() {
    local attrs line drv bad=0 n=0
    attrs=$(hgit check-attr filter eol working-tree-encoding ident -- .gitignore 2>/dev/null) \
        || fail 3 local "git check-attr failed"
    # A PR can set filter=unspecified as a literal value, which check-attr
    # prints like the unset sentinel; it passes only with no such driver.
    git -C "$TOP" config --get-regexp '^filter\.unspecified\.' >/dev/null 2>&1
    case $? in
        0) drv=1 ;;
        1) drv=0 ;;
        *) fail 3 local "cannot read the git config" ;;
    esac
    while IFS= read -r line; do
        n=$((n + 1))
        case "$line" in
            '.gitignore: filter: unspecified') [ "$drv" -eq 0 ] || bad=1 ;;
            '.gitignore: eol: unspecified' | '.gitignore: eol: lf') ;;
            '.gitignore: working-tree-encoding: unspecified' | '.gitignore: ident: unspecified') ;;
            *) bad=1 ;;
        esac
    done <<<"$attrs"
    [ "$n" -eq 4 ] || fail 3 local "git check-attr printed an unexpected answer"
    [ "$bad" -eq 1 ]
}

if fetch_entry .gitignore; then
    # The raw blob is only what checkout writes when .gitignore has no
    # content-transforming attribute (the head's root .gitattributes, this
    # clone's info/attributes and core.attributesFile all count). Judge this
    # clone's own attributes first, before the head's .gitattributes is in the
    # temp tree, then again with it, since the head can override them. A
    # transform that survives and comes from this clone alone fails every PR
    # the same way, so that is systemic rather than this PR's.
    local_bad=0
    ! attrs_bad || local_bad=1
    if fetch_entry .gitattributes && attrs_bad; then
        [ "$local_bad" -eq 1 ] \
            && fail 3 local-attributes "this clone's info/attributes or core.attributesFile sets a content-transforming attribute on .gitignore"
        fail 4 attributes "the PR head sets content-transforming attributes on .gitignore, so its ignore rules cannot be read from the blob"
    elif [ "$local_bad" -eq 1 ] && [ ! -e "$WT/.gitattributes" ]; then
        fail 3 local-attributes "this clone's info/attributes or core.attributesFile sets a content-transforming attribute on .gitignore"
    fi
fi

# -q exit only: with -v a negated match exits 0 too. --no-index: the real
# index can still track the path.
rc=0
hgit check-ignore -q --no-index -- yellow-plugins.local.md || rc=$?
case "$rc" in
    0) printf 'head=ignored sha=%s\n' "$SHA" ;;
    1) printf 'head=unignored sha=%s\n' "$SHA" ;;
    *) fail 3 local "git check-ignore failed" ;;
esac
