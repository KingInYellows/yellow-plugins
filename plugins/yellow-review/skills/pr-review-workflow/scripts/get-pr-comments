#!/bin/bash
# Fetch unresolved PR review threads via GitHub GraphQL API. Outdated threads
# are excluded unless --include-outdated is passed.
# Usage: get-pr-comments [--include-outdated] <owner/repo> <pr-number>
#   --include-outdated  also return unresolved threads whose anchor is outdated
# Output: JSON array of thread objects to stdout. Each thread has threadId,
#   path, line, startLine, comments[] (author, body, id, createdAt,
#   viewerDidAuthor, authorType), commentCount, commentsTruncated (true when
#   the thread has more comments than the 50 fetched), isOutdated,
#   viewerCanResolve and viewerCanReply.
# Errors: Exit 1 with a message to stderr for every failure, usage errors
#   included; callers key on zero vs non-zero and the rate-limit wording.
# Truncation: when the thread list hits the page cap or GitHub returns no
#   cursor, the script exits 3 with a message on stderr and the threads
#   fetched so far on stdout (still a plain array), so a partial list is
#   never mistaken for the full one. A caller that stops on any non-zero
#   exit needs no change. Per-thread comment truncation (more than 50
#   comments) is the commentsTruncated field, not an exit code.

set -euo pipefail

# --- Dependency checks ---
command -v gh >/dev/null 2>&1 || { printf 'Error: gh CLI not found. Install from https://cli.github.com\n' >&2; exit 1; }
command -v jq >/dev/null 2>&1 || { printf 'Error: jq not found. Install from https://jqlang.github.io/jq\n' >&2; exit 1; }

# --- Input validation ---
INCLUDE_OUTDATED=false
POSITIONAL=()
for arg in "$@"; do
    case "$arg" in
        --include-outdated) INCLUDE_OUTDATED=true ;;
        --*)
            printf 'Error: Unknown flag: %s\n' "$arg" >&2
            exit 1
            ;;
        *) POSITIONAL+=("$arg") ;;
    esac
done

if [ "${#POSITIONAL[@]}" -ne 2 ]; then
    printf 'Usage: get-pr-comments [--include-outdated] <owner/repo> <pr-number>\n' >&2
    exit 1
fi

REPO="${POSITIONAL[0]}"
PR_NUMBER="${POSITIONAL[1]}"

# Validate owner/repo format
case "$REPO" in
    */*)
        OWNER="${REPO%%/*}"
        NAME="${REPO#*/}"
        if [ -z "$OWNER" ] || [ -z "$NAME" ]; then
            printf 'Error: Invalid repo format. Expected owner/repo, got: %s\n' "$REPO" >&2
            exit 1
        fi
        ;;
    *)
        printf 'Error: Invalid repo format. Expected owner/repo, got: %s\n' "$REPO" >&2
        exit 1
        ;;
esac

# Validate PR number is numeric
case "$PR_NUMBER" in
    ''|*[!0-9]*)
        printf 'Error: PR number must be numeric, got: %s\n' "$PR_NUMBER" >&2
        exit 1
        ;;
esac

# --- Pagination constants ---
MAX_PAGES=10
PAGE_SIZE=100

# --- GraphQL query with cursor pagination ---
# shellcheck disable=SC2016
QUERY='
query($owner: String!, $name: String!, $number: Int!, $cursor: String, $pageSize: Int!) {
  repository(owner: $owner, name: $name) {
    pullRequest(number: $number) {
      reviewThreads(first: $pageSize, after: $cursor) {
        pageInfo { hasNextPage endCursor }
        nodes {
          id
          isResolved
          isOutdated
          viewerCanResolve
          viewerCanReply
          path
          line
          startLine
          comments(first: 50) {
            totalCount
            nodes {
              id
              author { __typename login }
              body
              createdAt
              viewerDidAuthor
            }
          }
        }
      }
    }
  }
}'

# --- Paginated fetch loop ---
ALL_PAGES=()
CURSOR=""
PAGE=0
TRUNCATED=false

_STDERR_FILE=$(mktemp)
trap 'rm -f "$_STDERR_FILE"' EXIT

while true; do
    PAGE=$((PAGE + 1))

    # Execute query — separate stdout from stderr to avoid gh warnings poisoning JSON
    # Use && ... || to capture exit code without triggering set -e on failure
    if [ -z "$CURSOR" ]; then
        CURSOR_ARGS=(-F cursor=null)
    else
        CURSOR_ARGS=(-f cursor="$CURSOR")
    fi
    RESPONSE=$(gh api graphql \
        -f owner="$OWNER" \
        -f name="$NAME" \
        -F "number=$PR_NUMBER" \
        "${CURSOR_ARGS[@]}" \
        -F "pageSize=$PAGE_SIZE" \
        -f query="$QUERY" 2>"$_STDERR_FILE") && _GH_EXIT=0 || _GH_EXIT=$?
    _GH_STDERR=$(cat "$_STDERR_FILE")
    if [ "$_GH_EXIT" -ne 0 ]; then
        # Parse error category from stderr. Rate limits come first: GitHub
        # reports a secondary rate limit as HTTP 403. Status codes match only
        # as "HTTP <code>", so digits elsewhere in the text do not classify.
        _GH_LC=$(printf '%s' "$_GH_STDERR" | tr '[:upper:]' '[:lower:]')
        case "$_GH_LC" in
            *"rate limit"*|*"http 429"*)
                printf 'Error: GitHub API rate limit exceeded. Wait and retry.\n' >&2
                ;;
            *"http 401"*|*"bad credentials"*|*"authentication"*)
                printf 'Error: Authentication failed. Run "gh auth login" to re-authenticate.\n' >&2
                ;;
            *"http 403"*|*"forbidden"*|*"permission"*|*"resource not accessible"*)
                printf 'Error: Insufficient permissions for this repo.\n' >&2
                ;;
            *"could not resolve"*|*"http 404"*|*"not found"*|*"not_found"*)
                printf 'Error: Repository or PR not found: %s #%s\n' "$REPO" "$PR_NUMBER" >&2
                ;;
            *"http 5"[0-9][0-9]*|*"server error"*)
                printf 'Error: GitHub server error. Retry in a few minutes.\n' >&2
                ;;
            *)
                printf 'Error: GraphQL query failed (page %d): %s\n' "$PAGE" "$_GH_STDERR" >&2
                ;;
        esac
        exit 1
    fi

    # --- Validate response shape ---
    JQ_ERR=""
    if ! JQ_ERR=$(printf '%s' "$RESPONSE" | jq -e '.data.repository.pullRequest.reviewThreads' 2>&1 >/dev/null); then
        ERRORS=$(printf '%s' "$RESPONSE" | jq -r '.errors[0].message // empty' 2>/dev/null)
        if [ -n "$ERRORS" ]; then
            printf '[get-pr-comments] Error: GraphQL error: %s\n' "$ERRORS" >&2
        elif [ -n "$JQ_ERR" ]; then
            printf '[get-pr-comments] Error: jq parse error: %s\n' "$JQ_ERR" >&2
        else
            printf '[get-pr-comments] Error: Unexpected response shape from GitHub API.\n' >&2
        fi
        exit 1
    fi

    # --- Accumulate threads (O(n) — array append, merge once at end) ---
    PAGE_THREADS=$(printf '%s' "$RESPONSE" | jq '.data.repository.pullRequest.reviewThreads.nodes // []' 2>&1) || {
        printf '[get-pr-comments] Error: Failed to extract threads from page %d: %s\n' "$PAGE" "$PAGE_THREADS" >&2
        exit 1
    }
    ALL_PAGES+=("$PAGE_THREADS")

    # --- Check pagination ---
    HAS_MORE=$(printf '%s' "$RESPONSE" | jq -r '.data.repository.pullRequest.reviewThreads.pageInfo.hasNextPage // false') || {
        printf '[get-pr-comments] Error: Failed to read pagination state on page %d. Aborting.\n' "$PAGE" >&2
        exit 1
    }
    if [ "$HAS_MORE" != "true" ]; then
        break
    fi

    CURSOR=$(printf '%s' "$RESPONSE" | jq -r '.data.repository.pullRequest.reviewThreads.pageInfo.endCursor // empty')
    if [ -z "$CURSOR" ]; then
        # Inconsistent state: hasNextPage=true but no cursor to continue
        printf '[get-pr-comments] Error: pagination truncated — hasNextPage=true but no endCursor (page %d). Exiting 3 with the threads fetched so far.\n' "$PAGE" >&2
        TRUNCATED=true
        break
    fi

    # Validate cursor format (base64-like chars only — defense against injection)
    case "$CURSOR" in
        *[!a-zA-Z0-9+/=_-]*)
            printf '[get-pr-comments] Error: Invalid cursor format from GitHub API (page %d). Aborting pagination.\n' "$PAGE" >&2
            exit 1
            ;;
    esac

    if [ "$PAGE" -ge "$MAX_PAGES" ]; then
        TOTAL=$((PAGE * PAGE_SIZE))
        printf '[get-pr-comments] Error: Reached pagination limit (%d pages, ~%d threads). Exiting 3 with the threads fetched so far.\n' "$MAX_PAGES" "$TOTAL" >&2
        TRUNCATED=true
        break
    fi
done

# --- Merge all pages (single jq call — O(n) instead of O(n²)) ---
ALL_THREADS=$(printf '%s\n' "${ALL_PAGES[@]}" | jq -s 'add // []') || {
    printf '[get-pr-comments] Error: Failed to merge thread pages.\n' >&2
    exit 1
}

# --- Filter and transform ---
# Existing fields keep their order; new fields are appended after them.
OUTPUT=$(printf '%s' "$ALL_THREADS" | jq --argjson includeOutdated "$INCLUDE_OUTDATED" '
  [
    .[]
    | select(.isResolved == false and ($includeOutdated or .isOutdated == false))
    | {
        threadId: .id,
        path: .path,
        line: .line,
        startLine: .startLine,
        comments: [
          (.comments.nodes // [])[]
          | {
              author: (.author.login // "ghost"),
              body: .body,
              id: .id,
              createdAt: .createdAt,
              viewerDidAuthor: (.viewerDidAuthor // false),
              authorType: (.author.__typename // null)
            }
        ],
        commentCount: (.comments.totalCount // ((.comments.nodes // []) | length)),
        commentsTruncated: ((.comments.totalCount // 0) > ((.comments.nodes // []) | length)),
        isOutdated: (.isOutdated // false),
        viewerCanResolve: (.viewerCanResolve // false),
        viewerCanReply: (.viewerCanReply // false)
      }
  ]') || {
    printf 'Error: Failed to transform GraphQL response.\n' >&2
    exit 1
}

printf '%s\n' "$OUTPUT"
# Exit 3 after printing: stdout holds the partial list, the status says it is partial.
if [ "$TRUNCATED" = true ]; then exit 3; fi
