diff --git a/src/lib/retry.ts b/src/lib/retry.ts
--- a/src/lib/retry.ts
+++ b/src/lib/retry.ts
@@ -1,3 +1,17 @@
+/** Retry `fn` with exponential backoff, capped at `maxDelayMs`. */
+export async function retry<T>(
+  fn: () => Promise<T>,
+  { attempts = 3, baseDelayMs = 100, maxDelayMs = 2000 } = {}
+): Promise<T> {
+  let lastError: unknown;
+  for (let i = 0; i < attempts; i += 1) {
+    try {
+      return await fn();
+    } catch (error) {
+      lastError = error;
+      await sleep(Math.min(baseDelayMs * 2 ** i, maxDelayMs));
+    }
+  }
+  throw lastError;
+}
