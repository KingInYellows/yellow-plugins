diff --git a/src/tax/vat.ts b/src/tax/vat.ts
--- a/src/tax/vat.ts
+++ b/src/tax/vat.ts
@@ -40,6 +40,28 @@ export function vatRate(sale: Sale): Rate {
   }
+  // EU distance-selling: below the EUR 10,000 pan-EU threshold the seller
+  // charges its own country's rate; above it, the buyer's country rate.
+  // The threshold is measured across all member states combined, not per
+  // country, and resets on 1 January. (Council Directive 2006/112/EC,
+  // art. 59c, as amended by (EU) 2017/2455.)
+  if (isEu(sale.sellerCountry) && isEu(sale.buyerCountry)) {
+    if (sale.sellerYtdCrossBorder < EU_DISTANCE_SELLING_THRESHOLD) {
+      return rateFor(sale.sellerCountry, sale.category);
+    }
+    return rateFor(sale.buyerCountry, sale.category);
+  }
+  // Northern Ireland is treated as EU for goods and UK for services under
+  // the Windsor Framework, so the category decides which side applies.
+  if (sale.buyerCountry === 'XI') {
+    return sale.category === 'goods'
+      ? rateFor('IE', sale.category)
+      : rateFor('GB', sale.category);
+  }
   return rateFor(sale.buyerCountry, sale.category);
 }
