#!/bin/sh
# Mock gh CLI for bats tests
# Serves fixture JSON based on PR number or thread ID in arguments
set -eu

FIXTURE_DIR="${BATS_FIXTURE_DIR:-$(dirname "$0")/../fixtures}"

# Extract PR number or thread ID from arguments
ALL_ARGS="$*"

# State file for multi-page pagination (tracks call count per PR)
PAGE_STATE_DIR="${BATS_TEST_TMPDIR:-/tmp}"

# Emulate `gh api --jq <expr>`: print the value after --jq, if any.
jq_expr() {
  _want=0
  for _a in "$@"; do
    if [ "$_want" = 1 ]; then printf '%s' "$_a"; return 0; fi
    [ "$_a" = "--jq" ] && _want=1
  done
  return 0
}

# Print JSON, applying --jq when the caller passed one.
emit() {
  _expr=$(jq_expr "$@")
  if [ -n "$_expr" ]; then
    printf '%s' "$MOCK_BODY" | jq -r "$_expr"
  else
    printf '%s\n' "$MOCK_BODY"
  fi
}

# Print an HTTP response the way `gh api` does: headers first only when -i
# was passed. $1 = status line, $2 = extra header lines (may be empty),
# MOCK_BODY = body.
http() {
  case " $* $ALL_ARGS " in
    *" -i "*|*" --include "*)
      printf '%s\r\nContent-Type: application/json\r\n' "$1"
      [ -n "$2" ] && printf '%s\r\n' "$2"
      printf '\r\n'
      ;;
  esac
  printf '%s\n' "$MOCK_BODY"
}

# Count calls per key in BATS_TEST_TMPDIR; prints the new count.
bump() {
  _f="${PAGE_STATE_DIR}/mock_gh_count_$1"
  _n=$(( $(cat "$_f" 2>/dev/null || printf 0) + 1 ))
  printf '%s' "$_n" >| "$_f"
  printf '%s' "$_n"
}

# Arms keyed on query or endpoint text come first so the number=/PRRT_ arms
# below never capture them.
case "$ALL_ARGS" in
  *"FollowupViewer"*)
    # file-followup-issue viewer lookup. MOCK_GH_VIEWER overrides the login.
    MOCK_BODY="{\"data\":{\"viewer\":{\"login\":\"${MOCK_GH_VIEWER:-me}\"}}}"
    emit "$@"
    exit 0
    ;;
  *"FollowupThreadUrl"*)
    MOCK_BODY='{"data":{"node":{"comments":{"nodes":[{"url":"https://github.com/test/repo/pull/7#discussion_r1"}]}}}}'
    emit "$@"
    exit 0
    ;;
  "issue list "*)
    cat "$FIXTURE_DIR/issue-list-response.json"
    exit 0
    ;;
  "issue create "*)
    # Saves the title and body for assertions. MOCK_GH_ISSUE_CREATE_FAIL=1
    # simulates a failure.
    if [ "${MOCK_GH_ISSUE_CREATE_FAIL:-0}" = 1 ]; then
      printf 'HTTP 422: Validation Failed\n' >&2
      exit 1
    fi
    bump issue_create >/dev/null
    _next=""
    for a in "$@"; do
      case "$_next" in
        title) printf '%s' "$a" >| "${PAGE_STATE_DIR}/mock_gh_issue_title" ;;
        body) cat "$a" >| "${PAGE_STATE_DIR}/mock_gh_issue_body" ;;
      esac
      case "$a" in
        --title) _next=title ;;
        --body-file) _next=body ;;
        *) _next="" ;;
      esac
    done
    printf 'Creating issue in test/repo\n\nhttps://github.com/test/repo/issues/77\n'
    exit 0
    ;;
  *"ReplyPrecheck"*)
    # reply-pr-thread pre-check: the thread's last comment.
    case "$ALL_ARGS" in
      *"PRRT_reply_done"*)
        MOCK_BODY='{"data":{"node":{"id":"PRRT_reply_done","comments":{"nodes":[{"viewerDidAuthor":true,"body":"Fixed in abc1234.\n\n<!-- yellow-review:resolve v1 thread=PRRT_reply_done disposition=fixed -->\n"}]}}}}'
        ;;
      *"PRRT_reply_spoof"*)
        MOCK_BODY='{"data":{"node":{"id":"PRRT_reply_spoof","comments":{"nodes":[{"viewerDidAuthor":false,"body":"> <!-- yellow-review:resolve v1 thread=PRRT_reply_spoof disposition=fixed -->"}]}}}}'
        ;;
      *"PRRT_reply_gone"*)
        MOCK_BODY='{"data":{"node":null}}'
        ;;
      *)
        MOCK_BODY='{"data":{"node":{"id":"PRRT_reply_x","comments":{"nodes":[{"viewerDidAuthor":false,"body":"Please add a null check."}]}}}}'
        ;;
    esac
    http "HTTP/2.0 200 OK" ""
    exit 0
    ;;
  *"addPullRequestReviewThreadReply"*)
    # reply-pr-thread mutation. Saves the posted body for assertions.
    n=$(bump reply)
    for a in "$@"; do
      case "$a" in body=@*) cat "${a#body=@}" >| "${PAGE_STATE_DIR}/mock_gh_reply_body" ;; esac
    done
    case "$ALL_ARGS" in
      *"PRRT_reply_rl2"*|*"PRRT_reply_rl"*)
        # rl: limited on the first call only. rl2: always limited, no header.
        case "$ALL_ARGS" in *"PRRT_reply_rl2"*) limited=1 ;; *) [ "$n" -eq 1 ] && limited=1 || limited=0 ;; esac
        if [ "$limited" = 1 ]; then
          MOCK_BODY='{"message":"You have exceeded a secondary rate limit."}'
          case "$ALL_ARGS" in
            *"PRRT_reply_rl2"*) http "HTTP/2.0 403 Forbidden" "" ;;
            *) http "HTTP/2.0 429 Too Many Requests" "Retry-After: 0" ;;
          esac
          printf 'gh: You have exceeded a secondary rate limit. (HTTP 403)\n' >&2
          exit 1
        fi
        ;;
      *"PRRT_reply_gqlrl"*)
        if [ "$n" -eq 1 ]; then
          MOCK_BODY='{"errors":[{"type":"RATE_LIMITED","message":"API rate limit exceeded for user."}]}'
          http "HTTP/2.0 200 OK" ""
          printf 'gh: API rate limit exceeded for user.\n' >&2
          exit 1
        fi
        ;;
      *"PRRT_reply_forbidden"*)
        MOCK_BODY='{"errors":[{"type":"FORBIDDEN","message":"Resource not accessible by integration"}]}'
        http "HTTP/2.0 200 OK" ""
        printf 'gh: Resource not accessible by integration\n' >&2
        exit 1
        ;;
    esac
    MOCK_BODY='{"data":{"addPullRequestReviewThreadReply":{"comment":{"id":"PRRC_new"}}}}'
    http "HTTP/2.0 200 OK" ""
    exit 0
    ;;
  *"latestOpinionatedReviews"*)
    # get-pr-blockers review lookup. MOCK_GH_BLOCKERS_FAIL=1 simulates an
    # API failure.
    if [ "${MOCK_GH_BLOCKERS_FAIL:-0}" = 1 ]; then
      printf 'gh: Something went wrong (HTTP 502)\n' >&2
      exit 1
    fi
    cat "$FIXTURE_DIR/${MOCK_GH_BLOCKERS_FIXTURE:-blockers-response.json}"
    exit 0
    ;;
  *"/protection"*)
    # Classic branch protection. MOCK_GH_PROTECTION: enabled | disabled |
    # notprotected | 403 | 404 (default).
    case "${MOCK_GH_PROTECTION:-404}" in
      enabled) MOCK_BODY='{"required_conversation_resolution":{"enabled":true}}'; emit "$@" ;;
      disabled) MOCK_BODY='{"required_conversation_resolution":{"enabled":false}}'; emit "$@" ;;
      notprotected)
        printf '{"message":"Branch not protected"}gh: Branch not protected (HTTP 404)\n' >&2
        exit 1
        ;;
      403) printf 'gh: Resource not accessible by integration (HTTP 403)\n' >&2; exit 1 ;;
      *) printf '{"message":"Not Found"}gh: Not Found (HTTP 404)\n' >&2; exit 1 ;;
    esac
    exit 0
    ;;
  *"/rules/branches/"*)
    # Branch rulesets. MOCK_GH_RULES: enforced | none (default) | fail.
    case "${MOCK_GH_RULES:-none}" in
      enforced) MOCK_BODY='[{"type":"deletion"},{"type":"pull_request","parameters":{"required_review_thread_resolution":true}}]'; emit "$@" ;;
      fail) printf 'gh: Server Error (HTTP 500)\n' >&2; exit 1 ;;
      *) MOCK_BODY='[{"type":"deletion"},{"type":"pull_request","parameters":{"required_review_thread_resolution":false}}]'; emit "$@" ;;
    esac
    exit 0
    ;;
esac

case "$ALL_ARGS" in
  *"number=123"*)
    cat "$FIXTURE_DIR/single-page-response.json"
    ;;
  *"number=200"*)
    cat "$FIXTURE_DIR/empty-threads-response.json"
    ;;
  *"number=300"*)
    # Multi-page: serve page1 on first call, page2 on subsequent calls
    PAGE_FILE="${PAGE_STATE_DIR}/mock_gh_pr300_page"
    if [ -f "$PAGE_FILE" ]; then
      cat "$FIXTURE_DIR/multi-page-response-page2.json"
    else
      printf '1' > "$PAGE_FILE"
      cat "$FIXTURE_DIR/multi-page-response-page1.json"
    fi
    ;;
  *"number=350"*)
    # Null cursor: hasNextPage=true but endCursor=null
    cat "$FIXTURE_DIR/null-cursor-response.json"
    ;;
  *"number=999"*)
    # Simulate GraphQL error
    cat "$FIXTURE_DIR/graphql-error-response.json" >&2
    exit 1
    ;;
  *"number=401"*)
    printf 'Bad credentials' >&2
    exit 1
    ;;
  *"PRRT_valid"*)
    cat "$FIXTURE_DIR/resolve-success-response.json"
    ;;
  *"PRRT_notfound"*)
    printf 'Could not resolve to a node' >&2
    exit 1
    ;;
  *"PRRT_resolved"*)
    printf 'already resolved' >&2
    exit 1
    ;;
  *"pr view "*)
    # Review-ledger PR metadata. MOCK_GH_FAIL=1 simulates an unreachable
    # API; the state and OIDs come from the environment.
    if [ "${MOCK_GH_FAIL:-0}" = 1 ]; then
      printf 'mock gh: pr view failed\n' >&2
      exit 1
    fi
    printf '{"state":"%s","headRefOid":"%s","baseRefOid":"%s"}\n' \
      "${MOCK_GH_PR_STATE:-OPEN}" "${MOCK_GH_HEAD_OID:-}" "${MOCK_GH_BASE_OID:-}"
    ;;
  *)
    printf 'Mock gh: unhandled arguments: %s\n' "$ALL_ARGS" >&2
    printf 'Available mock patterns:\n' >&2
    printf '  number=123  → single-page-response.json\n' >&2
    printf '  number=200  → empty-threads-response.json\n' >&2
    printf '  number=300  → multi-page-response (page1 then page2)\n' >&2
    printf '  number=350  → null-cursor-response.json\n' >&2
    printf '  number=999  → graphql-error-response.json\n' >&2
    printf '  number=401  → auth failure\n' >&2
    printf '  PRRT_valid  → resolve-success-response.json\n' >&2
    printf '  PRRT_notfound → not found error\n' >&2
    printf '  PRRT_resolved → already resolved error\n' >&2
    printf '  pr view <n>  → {state,headRefOid,baseRefOid} from MOCK_GH_* env\n' >&2
    printf '  latestOpinionatedReviews → blockers-response.json (MOCK_GH_BLOCKERS_*)\n' >&2
    printf '  */protection → MOCK_GH_PROTECTION; */rules/branches/* → MOCK_GH_RULES\n' >&2
    printf '  ReplyPrecheck / addPullRequestReviewThreadReply → PRRT_reply_* arms\n' >&2
    printf '  FollowupViewer / FollowupThreadUrl / issue list / issue create\n' >&2
    exit 1
    ;;
esac
