{
  "name": "yellow-agy",
  "version": "0.2.0",
  "private": true,
  "description": "Local supervised delegate on the Antigravity CLI (agy) under the owner's Google AI Pro sign-in — successor to yellow-jules",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run --dir tests"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=22.22.0 <25.0.0"
  }
}
