#!/usr/bin/env bash
# Fake `git` for github-stack-runtime.js tests. Only implements the
# subcommands the runtime calls (check-ref-format, remote, config
# remote.pushDefault, rev-parse --verify, merge-base --is-ancestor); behavior
# is env-var controlled so tests never depend on this repository's real
# remotes or branches.
#   FAKE_GIT_BRANCHES      space-separated local branches that exist
#   FAKE_GIT_NOT_ANCESTOR  space-separated "below:above" pairs that are NOT
#                          ancestor/descendant (every other pair is)
#   FAKE_GIT_ANCESTRY_EXIT exit code forced on merge-base (e.g. 128)
#   FAKE_GIT_REVPARSE_EXIT exit code forced on rev-parse --verify (e.g. 128)
if [ "$1" = "check-ref-format" ] && [ "$2" = "--branch" ]; then
  name="$3"
  if [ -z "$name" ] || [[ "$name" == -* ]] || [[ "$name" == *..* ]] || \
     [[ "$name" == *" "* ]] || [[ "$name" == /* ]] || [[ "$name" == */ ]] || \
     [[ "$name" == *~* ]] || [[ "$name" == *^* ]] || [[ "$name" == *:* ]] || \
     [[ "$name" == *"?"* ]] || [[ "$name" == *"*"* ]] || [[ "$name" == *"["* ]]; then
    echo "fatal: '$name' is not a valid branch name" >&2
    exit 128
  fi
  echo "$name"
  exit 0
fi
if [ "$1" = "remote" ] && [ -z "${2:-}" ]; then
  if [ -n "${FAKE_GIT_REMOTES:-}" ]; then
    printf '%b' "$FAKE_GIT_REMOTES"
  fi
  exit 0
fi
if [ "$1" = "remote" ] && [ "${2:-}" = "-v" ]; then
  # FAKE_GIT_REMOTE_URLS: "name=url" pairs separated by spaces.
  [ -n "${FAKE_GIT_REMOTE_LIST_EXIT:-}" ] && exit "$FAKE_GIT_REMOTE_LIST_EXIT"
  # FAKE_GIT_REMOTE_V: the whole `git remote -v` output, verbatim.
  if [ -n "${FAKE_GIT_REMOTE_V:-}" ]; then printf '%b' "$FAKE_GIT_REMOTE_V"; exit 0; fi
  # FAKE_GIT_REMOTE_PUSH_URLS: "name=url" pairs overriding a push URL.
  for pair in ${FAKE_GIT_REMOTE_URLS:-}; do
    name="${pair%%=*}"
    push="${pair#*=}"
    for over in ${FAKE_GIT_REMOTE_PUSH_URLS:-}; do
      [ "${over%%=*}" = "$name" ] && push="${over#*=}"
    done
    printf '%s\t%s (fetch)\n%s\t%s (push)\n' "$name" "${pair#*=}" "$name" "$push"
  done
  exit 0
fi
if [ "$1" = "config" ] && [ "$2" = "--get-regexp" ] && [ "$3" = '^remote\..*\.gh-resolved$' ]; then
  # FAKE_GIT_GH_RESOLVED: "name=value" pairs (`gh repo set-default` marks).
  [ -n "${FAKE_GIT_GH_RESOLVED_EXIT:-}" ] && exit "$FAKE_GIT_GH_RESOLVED_EXIT"
  [ -n "${FAKE_GIT_GH_RESOLVED:-}" ] || exit 1
  for pair in $FAKE_GIT_GH_RESOLVED; do
    printf 'remote.%s.gh-resolved %s\n' "${pair%%=*}" "${pair#*=}"
  done
  exit 0
fi
if [ "$1" = "config" ] && [ "$2" = "remote.pushDefault" ]; then
  if [ -n "${FAKE_GIT_PUSH_DEFAULT:-}" ]; then
    printf '%s\n' "$FAKE_GIT_PUSH_DEFAULT"
    exit 0
  fi
  exit 1
fi
if [ "$1" = "config" ] && [ "$2" = "--get-regexp" ]; then
  # FAKE_GIT_REMOTE_URLS: "name=url" pairs separated by spaces.
  [ -n "${FAKE_GIT_REMOTE_URLS:-}" ] || exit 1
  for pair in $FAKE_GIT_REMOTE_URLS; do
    printf 'remote.%s.url %s\n' "${pair%%=*}" "${pair#*=}"
  done
  exit 0
fi
if [ "$1" = "rev-parse" ] && [ "$2" = "--verify" ] && [ "$3" = "--quiet" ]; then
  if [ -n "${FAKE_GIT_REVPARSE_EXIT:-}" ]; then
    exit "$FAKE_GIT_REVPARSE_EXIT"
  fi
  name="${4#refs/heads/}"
  case " ${FAKE_GIT_BRANCHES:-} " in
    *" $name "*) exit 0 ;;
  esac
  exit 1
fi
if [ "$1" = "merge-base" ] && [ "$2" = "--is-ancestor" ]; then
  if [ -n "${FAKE_GIT_ANCESTRY_EXIT:-}" ]; then
    exit "$FAKE_GIT_ANCESTRY_EXIT"
  fi
  pair="${3#refs/heads/}:${4#refs/heads/}"
  case " ${FAKE_GIT_NOT_ANCESTOR:-} " in
    *" $pair "*) exit 1 ;;
  esac
  exit 0
fi
echo "unrecognized fake git invocation: $*" >&2
exit 5
