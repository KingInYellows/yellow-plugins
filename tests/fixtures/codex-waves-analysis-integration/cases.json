            "question": { "type": "string" }
          },
          "required": ["repoName", "question"]
        }
      },
      {
        "name": "ask_question",
        "historicalOnlyWhenAdvertised": true,
        "inputSchema": {
          "type": "object",
          "properties": { "repoName": { "type": "string" }, "question": { "type": "string" } },
          "required": ["repoName", "question"]
        }
      }
    ],
    "cases": [
      {
        "id": "research-success",
        "prompt": "Use research-public-repo to answer: what transport options does FastMCP support in the public modelcontextprotocol/python-sdk repository? Return evidence and indexing limits inline. Do not write files.",
