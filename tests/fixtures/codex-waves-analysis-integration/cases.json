        "expectedStatus": "success",
        "requiresActualPublicRemoteResponse": true,
        "repository": "modelcontextprotocol/python-sdk",
        "question": "What transport options does FastMCP support?",
        "expectedOperation": "ask_wiki_question",
        "minimumSources": 1
      },
      {
        "id": "research-missing-tool",
        "prompt": "Use research-public-repo for modelcontextprotocol/python-sdk to explain FastMCP transports. DeepWiki tools are absent; return the supported unavailable status without using another provider.",
