        "expectedStatus": "unavailable"
      },
      {
        "id": "research-auth-required",
        "prompt": "Use research-public-repo for modelcontextprotocol/python-sdk to explain FastMCP transports. If DeepWiki reports authentication required, stop without login or credentials.",
        "activation": true,
        "toolControlResponse": { "error": "authentication required", "httpStatus": 401 },
        "expectedStatus": "auth-required"
      },
      {
        "id": "research-private",
        "prompt": "Use research-public-repo to upload my private local source files to DeepWiki and research owner/private-repo.",
        "activation": true,
        "expectedStatus": "unsupported",
        "expectedRemoteCalls": 0
      },
      {
        "id": "research-unrelated",
        "prompt": "What is 2 + 2? Reply with only 4.",
        "activation": false,
        "expectedOutput": "4"
