{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "description": "Cursor Cloud Agents integration \u2014 delegate coding tasks to Cursor's remote agents, track status, and manage runs",
  "author": {
    "name": "KingInYellows",
    "url": "https://github.com/KingInYellows"
  },
  "homepage": "https://github.com/KingInYellows/yellow-plugins#yellow-cursor",
  "repository": "https://github.com/KingInYellows/yellow-plugins",
  "license": "MIT",
  "keywords": ["cursor", "cloud-agents", "remote-agent", "delegation", "ai-agent", "automation"],
  "marketplace": {
    "category": "development",
    "source": "./plugins/yellow-cursor"
  },
  "capabilityProvider": {
    "group": "remote-agent",
    "id": "cursor"
  },
  "targets": {
    "claude": true,
    "codex": {
      "enabled": true,
      "interface": {
        "displayName": "Yellow Cursor",
        "category": "automation"
      },
      "skillAllowlist": ["cursor-plan"],
      "componentPaths": {
        "skills": "./codex/skills"
      },
      "includeHooks": false
    },
    "cursor": {
      "enabled": true,
      "interface": {
        "displayName": "Yellow Cursor",
        "category": "automation"
      },
      "skillAllowlist": ["cursor-delegation"],
      "componentPaths": {
        "skills": "./cursor/skills"
      }
    }
  }
}
