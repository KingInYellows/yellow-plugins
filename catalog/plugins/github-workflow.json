{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "description": "GitHub-native stacked-PR provider. Foundation only: checks that the official github/gh-stack extension is installed and reports provider readiness. It performs no stack operations.",
  "author": {
    "name": "KingInYellows",
    "url": "https://github.com/KingInYellows"
  },
  "homepage": "https://github.com/KingInYellows/yellow-plugins/tree/main/plugins/github-workflow",
  "repository": "https://github.com/KingInYellows/yellow-plugins",
  "license": "MIT",
  "keywords": [
    "github",
    "gh-stack",
    "gh-cli",
    "stacked-prs",
    "pull-requests",
    "workflow",
    "provider"
  ],
  "dependencies": ["yellow-core"],
  "capabilityProvider": {
    "group": "stacked-pr",
    "id": "github"
  },
  "marketplace": {
    "description": "GitHub-native stacked-PR provider (setup + status only; no stack operations yet)",
    "category": "development",
    "source": "./plugins/github-workflow"
  },
  "targets": {
    "claude": true,
    "codex": {
      "enabled": false
    }
  }
}
