{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "description": "Google Jules integration (experimental) — observe Jules remote-agent sessions and stage their artifacts for local review",
  "author": {
    "name": "KingInYellows",
    "url": "https://github.com/KingInYellows"
  },
  "homepage": "https://github.com/KingInYellows/yellow-plugins#yellow-jules",
  "repository": "https://github.com/KingInYellows/yellow-plugins",
  "license": "MIT",
  "keywords": ["jules", "google", "remote-agent", "delegation", "ai-agent", "automation"],
  "marketplace": {
    "category": "development",
    "source": "./plugins/yellow-jules"
  },
  "capabilityProvider": {
    "group": "remote-agent",
    "id": "jules"
  },
  "lifecycle": {
    "status": "experimental",
    "installPolicy": "manual"
  },
  "targets": {
    "claude": true,
    "codex": {
      "enabled": true,
      "includeHooks": false,
      "interface": {
        "displayName": "Jules",
        "category": "Developer Tools"
      },
      "description": "Two read-only reference skills — the Jules delegation lifecycle and CLI contract, and the one-pass supervision loop. Writes always need a grant the owner creates on a terminal. Excludes all of yellow-jules' commands.",
      "skillAllowlist": ["jules-delegation", "jules-supervision"],
      "componentPaths": {
        "skills": "./codex/skills"
      }
    }
  }
}
