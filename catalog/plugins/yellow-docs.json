{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "description": "Documentation audit, generation, and evidence-backed technical diagrams for any repository",
  "author": {
    "name": "KingInYellows",
    "url": "https://github.com/KingInYellows"
  },
  "homepage": "https://github.com/KingInYellows/yellow-plugins#yellow-docs",
  "repository": "https://github.com/KingInYellows/yellow-plugins",
  "license": "MIT",
  "keywords": ["documentation", "docs", "mermaid", "audit", "generation"],
  "marketplace": {
    "category": "development",
    "source": "./plugins/yellow-docs"
  },
  "targets": {
    "claude": true,
    "codex": {
      "enabled": true,
      "includeHooks": false,
      "interface": {
        "displayName": "yellow-docs",
        "category": "Developer Tools"
      },
      "skillAllowlist": ["docs-audit", "technical-diagrams"],
      "componentPaths": {
        "skills": "./codex/skills"
      },
      "description": "Audit repository documentation and create or revise editable technical diagrams with user approval."
    }
  }
}
