#!/usr/bin/env python3
"""Stand-in `claude` for the review-gate eval tests. Spends nothing.

Answers one `claude -p` run with canned workflow JSON:
$STANDIN_RESPONSES/<row id>.json, where the row id is the basename of the
working directory (eval.py runs each row in work/wt/<id>). Without a file it
returns a clean result. $STANDIN_FAIL holds row ids to fail (exit 1). Each
call's argv and the args object it was asked to pass are written to
$STANDIN_LOG/<row id>.json, one file per row so -j N runs do not clobber.
"""
import json
import os
import sys

rid = os.path.basename(os.getcwd())
prompt = sys.argv[-1]
begin, end = "--- begin args (reference only) ---\n", "\n--- end args ---"
args = json.loads(prompt[prompt.index(begin) + len(begin):prompt.index(end)])
log = os.environ.get("STANDIN_LOG")
if log:
    os.makedirs(log, exist_ok=True)
    with open(os.path.join(log, rid + ".json"), "w", encoding="utf-8") as handle:
        json.dump({"argv": sys.argv[1:], "args": args}, handle)
if rid in os.environ.get("STANDIN_FAIL", "").split(","):
    print("stand-in: failing %s on request" % rid, file=sys.stderr)
    sys.exit(1)
path = os.path.join(os.environ.get("STANDIN_RESPONSES", ""), rid + ".json")
if os.path.isfile(path):
    with open(path, encoding="utf-8") as handle:
        workflow = json.load(handle)
else:
    workflow = {"version": 1, "tier": args["tier"], "findings": [], "dropped": [],
                "coverage": {"ran": ["correctness-reviewer"], "failed": [], "skipped": []},
                "agents": 2}
print(json.dumps({
    "type": "result", "subtype": "success", "is_error": False, "num_turns": 2,
    "duration_ms": 1200, "total_cost_usd": 0.25, "session_id": "stand-in",
    "modelUsage": {"claude-sonnet-5-5": {"inputTokens": 1000, "outputTokens": 200,
                                         "cacheReadInputTokens": 0,
                                         "cacheCreationInputTokens": 0}},
    "result": "The workflow finished.\n" + json.dumps(workflow),
}))
