{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KingInYellows/yellow-plugins/scripts/eval/review-gate/schema/case.schema.json",
  "title": "review-gate eval case",
  "description": "A real defect the user confirmed, replayed against review-gate. Found when an Important finding names a golden file, lands within 3 lines of its line, and matches every regex in title plus suggested_fix.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "repo",
    "base",
    "head",
    "lane",
    "tier",
    "golden",
    "source",
    "confirmed_by",
    "confirmed_at"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "pr": { "type": ["integer", "null"], "minimum": 1 },
    "base": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "lane": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "tier": { "enum": ["low", "medium", "high"] },
    "golden": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "line", "match"],
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\s][^\\u0000]*$"
          },
          "line": { "type": "integer", "minimum": 1 },
          "match": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "include": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Za-z0-9:_.-]+$" }
    },
    "exclude": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Za-z0-9:_.-]+$" }
    },
    "source": { "type": "string", "minLength": 1 },
    "confirmed_by": { "type": "string", "minLength": 1 },
    "confirmed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "example": { "type": "boolean" },
    "notes": { "type": "string" }
  }
}
