{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KingInYellows/yellow-plugins/scripts/eval/review-gate/schema/synthetic.schema.json",
  "title": "review-gate eval synthetic control",
  "description": "A clean change written for the eval: <id>.patch next to this file, applied on top of base. There is no merged PR and no head commit; prepare builds head from base plus the patch. Any Important finding counts as a false positive.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "repo", "base", "tier", "source"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "base": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "tier": { "enum": ["low", "medium", "high"] },
    "include": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Za-z0-9:_.-]+$" }
    },
    "exclude": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Za-z0-9:_.-]+$" }
    },
    "source": { "type": "string", "minLength": 1 },
    "example": { "type": "boolean" },
    "notes": { "type": "string" }
  }
}
